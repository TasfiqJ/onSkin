PHASE9_ANONYMOUS_CAPTCHA_TOKEN=
PHASE9_ALLOW_PRODUCTION_LIVE_SUPABASE_ADVERSARIAL=false
# Edge-auth and data-rights live evidence are staging-only and have no
# production override. Both require the reviewed target contract above.
PHASE9_RUN_LIVE_EDGE_AUTH=false
PHASE9_RUN_LIVE_DATA_RIGHTS=false
# Destructive staging safeguard. Set true only for an approved disposable
# staging-account run. The protected GitHub workflow requires an explicit
