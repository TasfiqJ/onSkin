PHASE9_ALLOW_DESTRUCTIVE_ACCOUNT_DELETION=false
# Exact source revision for live evidence outside GitHub Actions. The protected
# workflow supplies its immutable github.sha/run/attempt/ref automatically.
PHASE9_EVIDENCE_SOURCE_SHA=
PHASE9_DATA_EXPORT_RATE_LIMIT_PROBE_MAX=7
PHASE9_DATA_EXPORT_SIGNED_URL_EXPIRY_CHECK=false
PHASE9_DATA_EXPORT_SIGNED_URL_EXPIRY_WAIT_SECONDS=0
PHASE9_RUN_LIVE_CONSENT_WITHDRAWAL=false
# Protected staging only. This harness waits for the deployed scheduled worker;
