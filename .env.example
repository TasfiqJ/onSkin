# --- Product and ingredient catalog sources (BLOCKED: B-CATALOG-SOURCE-REVIEW) -
# Offline catalog-source artifacts still require final identity, attribution,
# and ODbL review. Request-time Open Beauty Facts lookup is removed from the
# launch candidate; the legacy contribution flag is suppression-only.
CATALOG_APP_NAME=
CATALOG_APP_VERSION=0.1.0
CATALOG_CONTACT_EMAIL=
CATALOG_ATTRIBUTION_URL=
OBF_CONTRIBUTION_ENABLED=false
# Authenticated catalog Edge Function abuse caps. Stored server-side, not in the app bundle.
CATALOG_RATE_LIMIT_MAX=120
CATALOG_RATE_LIMIT_WINDOW_SECONDS=900
# Authenticated user Edge Function JSON body cap. Stored server-side, not in the app bundle.
USER_EDGE_BODY_MAX_BYTES=16384
# Third-party/provider calls from Edge Functions. Stored server-side, not in the app bundle.
EDGE_EXTERNAL_FETCH_TIMEOUT_MS=5000
EDGE_EXTERNAL_RESPONSE_MAX_BYTES=262144
# Authenticated data export abuse cap. Stored server-side, not in the app bundle.
DATA_EXPORT_RATE_LIMIT_MAX=5
DATA_EXPORT_RATE_LIMIT_WINDOW_SECONDS=3600
DATA_EXPORT_PHOTO_URL_TTL_SECONDS=3600

# --- Supabase (BLOCKED: B-SUPABASE) --------------------------------------------
SUPABASE_PROJECT_REF=your-staging-project-ref
# Project URL + the NEW publishable key (legacy anon/service_role keys are being
# deprecated by end of 2026 per docs/01 §5 — use publishable/secret keys).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key — Edge Functions / server only. Set via `supabase secrets set`,
# NOT in the client bundle. Listed here for documentation only.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Non-secret, independently reviewed target for the destructive Phase 9 live
# harnesses. Use the project's 20-character lowercase alphanumeric Reference
# ID. In GitHub, configure `STAGING_SUPABASE_PROJECT_REF` as a protected
# `staging-security` environment variable; the workflow maps it to this name.
# Its canonical origin must exactly equal SUPABASE_URL (no path or trailing `/`).
PHASE9_EXPECTED_SUPABASE_PROJECT_REF=

# --- RevenueCat (BLOCKED: B-REVENUECAT) ----------------------------------------
# Development native builds may use RevenueCat Test Store. Production must leave
# this blank; the app rejects test-like keys in production.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
# Placeholder local IDs only. Replace with the final App Store/Play/RevenueCat
# product IDs after brand clearance; strict Phase 6 gates fail until then.
EXPO_PUBLIC_REVENUECAT_ANNUAL_PRODUCT_ID=routinekind_pro_annual_dev
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=routinekind_pro_monthly_dev
# Webhook Authorization header value the RC dashboard is configured to send;
# verified inside the revenuecat-webhook Edge Function as defense in depth.
REVENUECAT_WEBHOOK_AUTH=replace-with-shared-secret
# HMAC signing secret shown once by the RevenueCat dashboard when webhook signing
# is enabled. Required for production webhook verification. Server-only secret.
REVENUECAT_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
REVENUECAT_WEBHOOK_MAX_BYTES=65536
# RevenueCat project identifier used to bind deletion/tombstone HMAC inputs to
# one project. It must be trimmed, nonempty, and at most 255 characters. This
# value is not a secret.
REVENUECAT_PROJECT_ID=
# Legacy secret API key retained for Phase 6/v1 compatibility. It does not
# authorize the durable RevenueCat REST API v2 deletion runtime. Never expose
# this in EXPO_PUBLIC_* or the mobile bundle.
REVENUECAT_SECRET_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
# Authenticated CustomerInfo reconciliation accepts only RevenueCat's fresh
# snake_case request_date. These bounded knobs control provider-cache age and
# per-account fetch pressure; no client-supplied subject or timestamp is used.
ENTITLEMENT_RECONCILIATION_MAX_SNAPSHOT_AGE_SECONDS=120
ENTITLEMENT_RECONCILIATION_RATE_LIMIT_MAX=6
ENTITLEMENT_RECONCILIATION_RATE_LIMIT_WINDOW_SECONDS=300
# Required RevenueCat V2 secret key for durable customer lookup/deletion and
# reconciliation. V1/legacy keys do not work with REST API v2. Grant only
# project read plus customer read/read-write permissions needed by the runbook.
# REVENUECAT_SECRET_API_KEY and REVENUECAT_REST_API_KEY are not fallbacks.
REVENUECAT_V2_SECRET_API_KEY=
# Versioned, domain-separated HMAC keyring used by account deletion and the
# webhook resurrection barrier. Generate independent 32-byte keys; never reuse
# provider, receipt, or payload keys. The parser accepts 1-4 unique keys in
# strictly increasing version order. The current version must be present.
# Format: 1=<64 lowercase hex>[;2=<64 lowercase hex>]. During rotation, add the
# new key before switching current version and retain every old key for the full
# unexpired tombstone overlap documented in the account-deletion runbook.
REVENUECAT_IDENTITY_TOMBSTONE_HMAC_CURRENT_VERSION=1
REVENUECAT_IDENTITY_TOMBSTONE_HMAC_KEYS=

# --- Google Sign-In (BLOCKED: B-GOOGLE) ----------------------------------------
# iOS client id + Web client id (the Web client id is the serverClientId used by
# the Android Credential Manager flow). See docs/01 §1.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# iOS reversed-client-id URL scheme. Add once the Google iOS OAuth client exists.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxx

# --- Apple Sign-In (BLOCKED: B-APPLE) ------------------------------------------
# SIWA token revocation (account deletion, Apple 5.1.1(v)) happens server-side
# in the account-deletion Edge Function. These are server-only secrets.
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_SIWA_CLIENT_ID=com.routinekind.app
APPLE_SIWA_SERVICE_ID=com.routinekind.app.signin
APPLE_SIWA_KEY_ID=XXXXXXXXXX
# Contents of the .p8 private key (newlines as \n) — store as Edge Function secret.
APPLE_SIWA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# --- Durable account deletion -------------------------------------------------
# Independent 32-byte server-only keys encoded as exactly 64 lowercase hex
# characters with no prefix, padding, or whitespace. Rotate only through the
# documented account-deletion runbook; the payload key currently has no online
# multi-key decrypt path.
ACCOUNT_DELETION_PAYLOAD_KEY_HEX=
ACCOUNT_DELETION_RECEIPT_HMAC_KEY_HEX=
# Integer 1-32767, without a sign or leading zeroes.
ACCOUNT_DELETION_RECEIPT_HMAC_KEY_VERSION=1
# Dedicated 256-bit scheduler capability, exactly 64 lowercase hex characters.
# Store the same value separately in Supabase Vault under the exact name
# `account_deletion_worker_secret`; never paste it into source or Cron SQL.
ACCOUNT_DELETION_WORKER_SECRET=

# --- Durable health-consent withdrawal ---------------------------------------
# Independent dedicated 256-bit scheduler capability, exactly 64 lowercase
# hex characters. Configure it as an Edge secret and copy it privately to Vault
# as `health_consent_worker_secret`; Vault also needs the exact hosted origin as
# `health_consent_project_url`. Never paste either value into Cron SQL.
HEALTH_CONSENT_WORKER_SECRET=
# Bounded worker governance controls. Defaults match the source-controlled
# one-minute Cron lane and remain subject to hosted staging evidence.
HEALTH_CONSENT_WORKER_CLAIM_LIMIT=10
HEALTH_CONSENT_WORKER_STORAGE_BATCH_SIZE=100
HEALTH_CONSENT_WORKER_MAX_STORAGE_BATCHES=5
HEALTH_CONSENT_WORKER_BUDGET_MS=45000
HEALTH_CONSENT_WORKER_RETRY_AFTER_SECONDS=60
HEALTH_CONSENT_WORKER_ACTION_REQUIRED_RETRY_AFTER_SECONDS=86400

# --- PostHog (BLOCKED: B-POSTHOG) ----------------------------------------------
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Personal API key for server-side person deletion on account delete. Server-only.
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxx
# Both values must be trimmed. Project ID is capped at 200 characters and the
# personal API key at 1,000 characters by the durable deletion runtime.
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
# Required durable-deletion attestation when PostHog deletion is in scope.
# Set CAPTURE_SHUTDOWN_AT only after capture really stopped. Set the evidence
# value to the exact literal below only after production storage is audited;
# VERIFIED_AT must be canonical UTC ISO-8601, at/after shutdown, and not future.
POSTHOG_CAPTURE_SHUTDOWN_AT=
POSTHOG_ABSENCE_INTERVAL_SECONDS=60
POSTHOG_NO_RECORDINGS_EVIDENCE=production_capture_disabled_and_storage_audited
POSTHOG_NO_RECORDINGS_VERIFIED_AT=

# --- Phase 9 release candidate evidence gates ---------------------------------
