# --- Sentry (BLOCKED: B-SENTRY) ------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# Auth token for uploading source maps in CI (EAS secret). Server-only.
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=routinekind

# --- Cloudflare Turnstile (BLOCKED: B-TURNSTILE) -------------------------------
# CAPTCHA for anonymous sign-in + signup abuse protection (docs/01 §5).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4xxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_FORMS_TURNSTILE_REQUIRED=false
PUBLIC_FORMS_RATE_LIMIT_MAX=20
PUBLIC_FORMS_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_FORMS_MAX_BYTES=8192
# Configure the same secret in Supabase Auth settings for anonymous sign-in/signup protection.

# --- ShopMy affiliate (BLOCKED: B-SHOPMY) — later slice (creator stacks) -------
SHOPMY_CLIENT_ID=
SHOPMY_CLIENT_SECRET=
# Server-only secret required by order-report-poll once SHOPMY_BRAND_API_KEY is set.
ORDER_REPORT_POLL_SECRET=replace-with-scheduler-secret
SHOPMY_BRAND_API_KEY=
