# --- ShopMy affiliate (BLOCKED: B-SHOPMY) — later slice (creator stacks) -------
SHOPMY_CLIENT_ID=
SHOPMY_CLIENT_SECRET=
# Server-only secret required by order-report-poll once SHOPMY_BRAND_API_KEY is set.
ORDER_REPORT_POLL_SECRET=replace-with-scheduler-secret
