PHASE9_BETA_EVIDENCE_PASS=false
PHASE9_SIGNED_OFF_BY=
PHASE9_RUN_LIVE_SUPABASE_ADVERSARIAL=false
# Required only when Supabase Auth CAPTCHA protection is enabled for anonymous sign-in.
