# =============================================================================
# RoutineKind — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Vars prefixed EXPO_PUBLIC_ are inlined into the client bundle at build time
# (Expo) — they are NOT secret. Anything truly secret (service-role keys,
# webhook secrets, provider client secrets) belongs ONLY in Supabase Edge
# Function secrets / EAS secrets, never in EXPO_PUBLIC_*.
#
# Each block references its BLOCKERS.md id so the founder can clear them in one
# pass. See BLOCKERS.md.
# =============================================================================

# --- App identity / EAS variants (BLOCKED: B-BRAND until counsel clears) -------
# Set to `cleared` only after the recorded brand/legal decision allows production
# use of the app name and bundle identity.
BRAND_LEGAL_CLEARANCE=pending

# APP_VARIANT controls installable variants in apps/mobile/app.config.js:
# development -> RoutineKind Dev / final cleared bundle ID + dev suffix
# staging     -> RoutineKind Staging / final cleared bundle ID + staging suffix
# production  -> requires final identity env or BRAND_LEGAL_CLEARANCE=cleared
APP_VARIANT=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CAMERA_STACK=expo-camera
EXPO_PUBLIC_NATIVE_CAMERA_ENABLED=true
# Keep false until a reviewed on-device ML Kit/Vision text-recognition module is
# built into a native dev build and passes real-label QA on iOS and Android.
EXPO_PUBLIC_NATIVE_OCR_ENABLED=false

# Use these only after the brand decision is recorded. They allow a rebrand
# without hand-editing app config. Do not set production values to the legacy
# conflicted name unless counsel clears the brand.
APP_DISPLAY_NAME=
EXPO_PUBLIC_APP_DISPLAY_NAME=RoutineKind
APP_SLUG=
APP_SCHEME=
EXPO_PUBLIC_APP_SCHEME=
APP_IOS_BUNDLE_IDENTIFIER=
APP_ANDROID_PACKAGE=
# Optional. Leave blank to derive native permission copy from APP_DISPLAY_NAME.
APP_CAMERA_USAGE_DESCRIPTION=
APP_FACE_ID_USAGE_DESCRIPTION=
APP_CAMERA_PERMISSION=
APP_FACE_ID_PERMISSION=

# --- Store listing / legal URLs (BLOCKED: B-POLICY-URLS) -----------------------
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_SUPPORT_URL=https://example.com/support
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://example.com/account-deletion
EXPO_PUBLIC_DATA_EXPORT_URL=https://example.com/data-export
EXPO_PUBLIC_CONSUMER_HEALTH_PRIVACY_URL=https://example.com/consumer-health-privacy
EXPO_PUBLIC_FINAL_BRAND_DOMAIN=
EXPO_PUBLIC_MARKETING_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# --- Phase 8 growth loop / store readiness gates ------------------------------
# Default OFF. Turn on public growth surfaces only after the final domain, store
# listings, app-link verification, FTC creator brief, support desk, privacy labels,
# and launch dashboard are signed off.
EXPO_PUBLIC_PHASE8_PUBLIC_LINKS_ENABLED=false
EXPO_PUBLIC_PHASE8_REVIEW_PROMPT_ENABLED=false
EXPO_PUBLIC_PHASE8_CREATOR_LINKS_ENABLED=false
EXPO_PUBLIC_PHASE8_PAID_MEASUREMENT_ENABLED=false

# Strict Phase 8 evidence. Set in CI/release shell, not the mobile bundle.
PHASE8_BRAND_SOURCE_OF_TRUTH_PASS=false
PHASE8_DOMAIN_DNS_PASS=false
PHASE8_IOS_UNIVERSAL_LINKS_PASS=false
PHASE8_ANDROID_APP_LINKS_PASS=false
PHASE8_SHARE_CARD_DEVICE_QA_PASS=false
PHASE8_ATTRIBUTION_PRIVACY_PASS=false
PHASE8_APP_STORE_PACKET_PASS=false
PHASE8_PLAY_STORE_PACKET_PASS=false
PHASE8_CREATOR_COMPLIANCE_PASS=false
PHASE8_SUPPORT_RESPONSE_PASS=false
PHASE8_LAUNCH_DASHBOARD_READY=false
PHASE8_DRY_RUN_PASS=false
PHASE8_SIGNED_OFF_BY=

# Domain association evidence. Server-side/build evidence only. Apple Team ID is
# documented in the Apple Sign-In block below and reused for AASA.
ANDROID_CERT_SHA256_FINGERPRINTS=

# --- Phase 7 core-loop launch gates -------------------------------------------
# Default all deferred surfaces OFF. In production they also require a real final
# brand domain. Turn on only after matching Phase 7 evidence is recorded in
# docs/phase-7 and the external PHASE7_* signoff vars pass.
EXPO_PUBLIC_PHASE7_COMMERCE_ENABLED=false
EXPO_PUBLIC_PHASE7_COMMUNITY_POSTING_ENABLED=false
EXPO_PUBLIC_PHASE7_TREND_ENABLED=false
EXPO_PUBLIC_PHASE7_CLOUD_ASK_ENABLED=false
EXPO_PUBLIC_PHASE7_WIDGETS_ENABLED=false
EXPO_PUBLIC_PHASE7_SHARE_CARD_ENABLED=false
EXPO_PUBLIC_PHASE7_REVIEWED_CONFLICT_SHARING_ENABLED=false
EXPO_PUBLIC_PHASE7_GOAL_ACTIVE_RECOMMENDATIONS_ENABLED=false

# Strict Phase 7 evidence. Set in CI/release shell, not the mobile bundle.
PHASE7_BRAND_READY=false
PHASE7_SUPABASE_RLS_PASS=false
PHASE7_CLINICAL_REVIEW_PASS=false
PHASE7_CATALOG_BETA_IMPORT_PASS=false
PHASE7_DEVICE_QA_PASS=false
PHASE7_REVENUECAT_QA_PASS=false
PHASE7_PRIVACY_EXPORT_DELETE_PASS=false
PHASE7_BETA_DASHBOARD_READY=false
PHASE7_SIGNED_OFF_BY=

# --- Product and ingredient catalog sources (BLOCKED: B-CATALOG-SOURCE-REVIEW) -
# Open Beauty Facts/Product Opener API requests require a custom User-Agent in
# the form AppName/Version (contact@example.com). Do not enable API/contribution
# in production until the final brand, support email, attribution page, and
# ODbL review are complete.
CATALOG_APP_NAME=
CATALOG_APP_VERSION=0.1.0
CATALOG_CONTACT_EMAIL=
CATALOG_ATTRIBUTION_URL=
OBF_USER_AGENT=
OBF_API_ENABLED=false
OBF_CONTRIBUTION_ENABLED=false
# Authenticated catalog Edge Function abuse caps. Stored server-side, not in the app bundle.
CATALOG_RATE_LIMIT_MAX=120
CATALOG_RATE_LIMIT_WINDOW_SECONDS=900
# Authenticated user Edge Function JSON body cap. Stored server-side, not in the app bundle.
USER_EDGE_BODY_MAX_BYTES=16384
# Third-party/provider calls from Edge Functions. Stored server-side, not in the app bundle.
EDGE_EXTERNAL_FETCH_TIMEOUT_MS=5000
EDGE_EXTERNAL_RESPONSE_MAX_BYTES=262144
# Authenticated data export abuse cap. Stored server-side, not in the app bundle.
DATA_EXPORT_RATE_LIMIT_MAX=5
DATA_EXPORT_RATE_LIMIT_WINDOW_SECONDS=3600
DATA_EXPORT_PHOTO_URL_TTL_SECONDS=3600

# --- Supabase (BLOCKED: B-SUPABASE) --------------------------------------------
SUPABASE_PROJECT_REF=your-staging-project-ref
# Project URL + the NEW publishable key (legacy anon/service_role keys are being
# deprecated by end of 2026 per docs/01 §5 — use publishable/secret keys).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key — Edge Functions / server only. Set via `supabase secrets set`,
# NOT in the client bundle. Listed here for documentation only.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- RevenueCat (BLOCKED: B-REVENUECAT) ----------------------------------------
# Development native builds may use RevenueCat Test Store. Production must leave
# this blank; the app rejects test-like keys in production.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
# Placeholder local IDs only. Replace with the final App Store/Play/RevenueCat
# product IDs after brand clearance; strict Phase 6 gates fail until then.
EXPO_PUBLIC_REVENUECAT_ANNUAL_PRODUCT_ID=routinekind_pro_annual_dev
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=routinekind_pro_monthly_dev
EXPO_PUBLIC_REVENUECAT_REVERSE_TRIAL_PRODUCT_ID=routinekind_pro_reverse_trial_local
# Webhook Authorization header value the RC dashboard is configured to send;
# verified inside the revenuecat-webhook Edge Function as defense in depth.
REVENUECAT_WEBHOOK_AUTH=replace-with-shared-secret
# HMAC signing secret shown once by the RevenueCat dashboard when webhook signing
# is enabled. Required for production webhook verification. Server-only secret.
REVENUECAT_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
REVENUECAT_WEBHOOK_MAX_BYTES=65536
# Secret API key for server-side customer deletion/reconciliation. Never expose
# this in EXPO_PUBLIC_* or the mobile bundle.
REVENUECAT_SECRET_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# --- Google Sign-In (BLOCKED: B-GOOGLE) ----------------------------------------
# iOS client id + Web client id (the Web client id is the serverClientId used by
# the Android Credential Manager flow). See docs/01 §1.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# iOS reversed-client-id URL scheme. Add once the Google iOS OAuth client exists.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxx

# --- Apple Sign-In (BLOCKED: B-APPLE) ------------------------------------------
# SIWA token revocation (account deletion, Apple 5.1.1(v)) happens server-side
# in the account-deletion Edge Function. These are server-only secrets.
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_SIWA_CLIENT_ID=com.routinekind.app
APPLE_SIWA_SERVICE_ID=com.routinekind.app.signin
APPLE_SIWA_KEY_ID=XXXXXXXXXX
# Contents of the .p8 private key (newlines as \n) — store as Edge Function secret.
APPLE_SIWA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# --- PostHog (BLOCKED: B-POSTHOG) ----------------------------------------------
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Personal API key for server-side person deletion on account delete. Server-only.
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
# Only set after counsel/privacy approves an alternate deletion workflow.
POSTHOG_DELETION_APPROVED_ALTERNATE=false

