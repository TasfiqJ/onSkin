# =============================================================================
# RoutineKind — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Vars prefixed EXPO_PUBLIC_ are inlined into the client bundle at build time
# (Expo) — they are NOT secret. Anything truly secret (service-role keys,
# webhook secrets, provider client secrets) belongs ONLY in Supabase Edge
# Function secrets / EAS secrets, never in EXPO_PUBLIC_*.
#
# Each block references its BLOCKERS.md id so the founder can clear them in one
# pass. See BLOCKERS.md.
# =============================================================================

# --- App identity / EAS variants (BLOCKED: B-BRAND until counsel clears) -------
# Set to `cleared` only after the recorded brand/legal decision allows production
# use of the app name and bundle identity.
BRAND_LEGAL_CLEARANCE=pending

# Production store builds fail closed until the Phase 3 reviewer logs and
# exact-source-hash packet have real legal, privacy/security, clinical,
# cosmetic-chemistry, and IP/FTO signoff. Keep `pending` for development and
# staging review; set `cleared` only in the production EAS environment after
# `npm run phase3:audit-copy:strict` passes against the signed packet. The flag
# is necessary but not sufficient: production config also validates the clean
# generated reviewer worklist, every release disposition, one current detached
# JSON signoff per released item, and current source/signoff hashes before it
# resolves.
PHASE3_RELEASE_CLEARANCE=pending

# APP_VARIANT controls installable variants in apps/mobile/app.config.js:
# development -> RoutineKind Dev / local install identity
# staging     -> requires final identity env and BRAND_LEGAL_CLEARANCE=cleared
# production  -> requires final identity env and BRAND_LEGAL_CLEARANCE=cleared
APP_VARIANT=development
# Server-side Edge environment. Keep it identical to EXPO_PUBLIC_APP_ENV; the
# Phase 2 and Edge validators reject contradictions.
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CAMERA_STACK=expo-camera
EXPO_PUBLIC_NATIVE_CAMERA_ENABLED=true
# Keep false until a reviewed on-device ML Kit/Vision text-recognition module is
# built into a native dev build and passes real-label QA on iOS and Android.
EXPO_PUBLIC_NATIVE_OCR_ENABLED=false

# --- Phase 5 native build/device QA evidence gates ----------------------------
# Set in CI/release shell only after physical iOS/Android device evidence exists.
# Native OCR remains optional and is required only if EXPO_PUBLIC_NATIVE_OCR_ENABLED=true.
PHASE5_IOS_BUILD_ID=
PHASE5_ANDROID_BUILD_ID=
PHASE5_IOS_DEVICE=
PHASE5_ANDROID_DEVICE=
PHASE5_QA_SIGNOFF=false
PHASE5_SIGNED_OFF_BY=
PHASE5_DEVICE_QA_PASS=false
PHASE5_INSTALL_QA_PASS=false
PHASE5_CAMERA_PERMISSION_QA_PASS=false
PHASE5_BARCODE_QA_PASS=false
PHASE5_LABEL_CAPTURE_QA_PASS=false
PHASE5_PROGRESS_PHOTO_QA_PASS=false
PHASE5_ENCRYPTED_PHOTO_STORAGE_QA_PASS=false
PHASE5_NOTIFICATION_QA_PASS=false
PHASE5_SHARE_SHEET_QA_PASS=false
PHASE5_REVENUECAT_NATIVE_QA_PASS=false
PHASE5_SENTRY_NATIVE_QA_PASS=false
PHASE5_SUPABASE_CATALOG_NATIVE_QA_PASS=false
PHASE5_ACCESSIBILITY_QA_PASS=false
PHASE5_NATIVE_OCR_QA_PASS=false

# Use these only after the brand decision is recorded. They allow a rebrand
# without hand-editing app config. Do not set production values to the legacy
# conflicted name unless counsel clears the brand.
APP_DISPLAY_NAME=
EXPO_PUBLIC_APP_DISPLAY_NAME=RoutineKind
APP_SLUG=
APP_SCHEME=
EXPO_PUBLIC_APP_SCHEME=
APP_IOS_BUNDLE_IDENTIFIER=
APP_ANDROID_PACKAGE=
# Optional. Leave blank to derive native permission copy from APP_DISPLAY_NAME.
APP_CAMERA_USAGE_DESCRIPTION=
APP_FACE_ID_USAGE_DESCRIPTION=
APP_CAMERA_PERMISSION=
APP_FACE_ID_PERMISSION=

# --- Store listing / legal URLs (BLOCKED: B-POLICY-URLS) -----------------------
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_SUPPORT_URL=https://example.com/support
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://example.com/account-deletion
