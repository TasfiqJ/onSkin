+// Drive the real required choice; finding text in the DOM does not make an
+// off-screen touch actionable. Never enable Add or bypass product validation.
+export async function chooseManualUnopened30({ client, scrollTextIntoView, clickByText, waitForText }) {
+  await scrollTextIntoView(client, 'Not opened yet');
+  await clickByText(client, 'Not opened yet');
+  await waitForText(client, 'Opening: Not opened yet.');
+}
diff --git a/scripts/e2e/manual-opening-choice30.test.mjs b/scripts/e2e/manual-opening-choice30.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6b88321b87c1088d0cbd92a50fcd370e636eb7df
--- /dev/null
+++ b/scripts/e2e/manual-opening-choice30.test.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { chooseManualUnopened30 } from './manual-opening-choice30.mjs';
+
+test('manual setup scrolls before touching and requires actual reviewed opening state', async () => {
+  const calls = [], client = {};
+  await chooseManualUnopened30({ client,
+    scrollTextIntoView: async (page, label) => { assert.equal(page, client); calls.push(['scroll', label]); },
+    clickByText: async (page, label) => { assert.equal(page, client); calls.push(['touch', label]); },
+    waitForText: async (page, label) => { assert.equal(page, client); calls.push(['verify', label]); },
+  });
+  assert.deepEqual(calls, [['scroll', 'Not opened yet'], ['touch', 'Not opened yet'], ['verify', 'Opening: Not opened yet.']]);
+});
+for (const failure of ['scrollTextIntoView', 'clickByText', 'waitForText']) {
+  test(`manual setup preserves ${failure} refusal`, async () => {
+    const seen = [];
+    const io = Object.fromEntries(['scrollTextIntoView', 'clickByText', 'waitForText'].map(name => [name, async () => {
+      seen.push(name); if (name === failure) throw new Error(failure);
+    }]));
+    await assert.rejects(chooseManualUnopened30({ client: {}, ...io }), new RegExp(failure));
+    assert.equal(seen.at(-1), failure);
+  });
+}
