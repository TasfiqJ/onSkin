@@ -0,0 +1,22 @@
+import { useState, type ReactNode } from 'react';
+import { ScrollView, View, useWindowDimensions } from 'react-native';
+import { Text } from '@/components/ui/Text';
+import { useInlineDialogFocus } from '@/lib/accessibility/modalBackground';
+
+/** Route-local decisions share the existing keyboard/background isolation. */
+export function IntakeDecisionDialog({ title, background, onCancel, children }: {
+  title: string; background: View | null; onCancel: () => void; children: ReactNode;
+}) {
+  const [dialog, setDialog] = useState<View | null>(null);
+  const { height } = useWindowDimensions();
+  useInlineDialogFocus(dialog, background, true, onCancel);
+  return <View className="absolute inset-0 justify-center px-4" style={{ backgroundColor: 'rgba(32,27,21,0.4)', zIndex: 30 }}>
+    <View ref={setDialog} role="dialog" aria-modal accessibilityViewIsModal accessibilityLabel={title}
+      tabIndex={-1} className="rounded-[20px] bg-paper p-5" style={{ maxHeight: Math.max(120, height - 48) }}>
+      <ScrollView style={{ flexShrink: 1 }} keyboardShouldPersistTaps="handled" contentContainerClassName="pb-2">
+        <Text variant="titleSm" accessibilityRole="header">{title}</Text>
+        {children}
+      </ScrollView>
+    </View>
+  </View>;
+}
