+
+async function saveDrafts() {
+  const lease = captureHealthDataWriteLease();
+  const manual = await saveManualIntakeDraft(lease, { id: randomUUID(), operationId: randomUUID(), expected: null,
+    fields: { form: { name: 'Private recovery name', brand: 'Private recovery brand', barcode: '',
+      ingredients: 'Private recovery ingredient text', category: null, eightDigitFormat: null, addedVia: 'manual' },
+    intake: createIntakeDraft(), phase: 'manual',
+    opening: { mode: null, selectedDate: null, paoMonths: null, paoSource: 'unknown', customPaoText: '' }, attempted: null } }, () => undefined);
+  const snapshot = await optionalStore.readOptionalChangeDraftHistory(lease);
+  const optional = await optionalStore.saveOptionalChangeDraft(lease, { id: randomUUID(), expected: null,
+    fields: { eventId: randomUUID(), kind: 'note', targetEventId: null, targetContentHash: null,
+      observedOn: localDateString(), category: 'personal_note', text: 'Private recovery factual note',
+      sourceRevision: snapshot.revision, sourceProof: snapshot.sourceProof, attempted: false } }, () => undefined);
+  privateStrings.push(manual.id, manual.operationId, optional.id, optional.fields.eventId);
+  return { manual, optional };
+}
