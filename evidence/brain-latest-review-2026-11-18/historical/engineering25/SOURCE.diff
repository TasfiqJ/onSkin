+
+it.each(drafts)('coalesces $title retries and recovers only through explicit Check again', async domain => {
+  await saveDrafts(); ports26.failRead = domain.key; await mount(); ports26.failRead = null;
+  const read = vi.spyOn(AsyncStorage, 'getItem'); const before = new Map(ports26.bytes); observeWrites();
