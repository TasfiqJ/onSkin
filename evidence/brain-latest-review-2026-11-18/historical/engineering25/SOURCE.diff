+  const product = await addProduct({ name: 'Private recovery product', brand: 'Private recovery brand', addedVia: 'manual' });
+  privateStrings.push(product.id);
+  await toggleCompletion('AM:private-recovery-step', localDateString());
+  await saveNotifPrefs({ amEnabled: true });
+  await runHealthDataOperation(OWNER, lease => writePhotoDeleteJournal([{ operationId: randomUUID(),
+    photoId: 'private-recovery-photo', ownerUserId: lease.ownerUserId, epoch: lease.epoch,
+    phase: 'prepared', remotePending: false, needsAttention: true, files: [] }], lease));
+  await saveDrafts();
+}
+function observeWrites() {
+  writes = [vi.spyOn(AsyncStorage, 'setItem'), vi.spyOn(AsyncStorage, 'removeItem'), vi.spyOn(AsyncStorage, 'multiRemove'),
+    vi.spyOn(privateSecureStore, 'setPrivateSecureStoreItemAsync'), vi.spyOn(privateSecureStore, 'deletePrivateSecureStoreItemAsync')];
+  writes.forEach(spy => spy.mockClear());
+}
+function noWrites() { for (const spy of writes) expect(spy).not.toHaveBeenCalled(); }
+function rendered() { return JSON.stringify(renderer!.toJSON()); }
+function row(title: string) {
+  return renderer!.root.findAll(node => node.type === ('View' as never) && node.props.accessibilityState?.busy !== undefined)
+    .find(node => node.findAll(child => child.type === ('Text' as never) && child.props.children === title).length > 0)!;
+}
+function rowText(title: string) { return JSON.stringify(row(title).findAllByType('Text' as never).map(node => node.props.children)); }
