+  noWrites(); expect(ports26.bytes).toEqual(before);
+});
+
+it('shows only generic saved evidence and leaves every original encrypted record unchanged', async () => {
+  await populated(); const before = new Map(ports26.bytes); observeWrites(); await mount();
+  for (const domain of domains) expect(rowText(domain.title)).toContain(domain.saved);
+  for (const secret of privateStrings) expect(rendered()).not.toContain(secret);
+  expect(rendered()).not.toMatch(/\b[0-9]+ drafts?\b/);
+  noWrites(); expect(ports26.bytes).toEqual(before); expect(ports26.track).not.toHaveBeenCalled();
+  const lease = captureHealthDataWriteLease();
+  for (const domain of RECOVERY_DOMAINS) {
+    const result = await readLocalRecoveryEvidence(domain, localDateString(), lease);
+    expect(Object.keys(result).sort()).toEqual(['message', 'status']);
+    for (const secret of privateStrings) expect(JSON.stringify(result)).not.toContain(secret);
+  }
+  noWrites(); expect(ports26.bytes).toEqual(before);
+});
+
+it.each(domains)('keeps every other status independent when $title is unreadable', async failed => {
+  await populated(); const before = new Map(ports26.bytes); ports26.failRead = failed.key;
