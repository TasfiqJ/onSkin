+      assertOriginalHealthDataWriteLease(lease);
+      if (!visible.current || focus.current !== currentFocus || selectedRef.current !== expected) throw new Error('BOTTLE_DRAFT_STALE');
+    };
+    try { guard(); } catch { return; }
+    flight.current = attempt; setBusy(true); setError(false);
+    try {
+      await discardBottleDraft(lease, expected, guard); guard();
+      selectedRef.current = null; setSelected(null);
+      const result = await loadBottleDrafts(lease);
+      assertOriginalHealthDataWriteLease(lease);
+      if (visible.current && focus.current === currentFocus && flight.current === attempt) setCollection(result);
+    } catch { if (visible.current && focus.current === currentFocus) { setError(true); setCollection(null); } }
+    finally { if (flight.current === attempt) { flight.current = null; setBusy(false); } }
+  }
+  return <Screen edges={['top', 'bottom']}>
+    <Text variant="titleSm">Saved bottle drafts</Text>
+    <Text variant="bodySm" className="mt-3">Unconfirmed transcription, encrypted on this device. Resume opens the bottle for an explicit saved-source review. Removing a product does not erase its draft; you can discard it here. Privacy withdrawal or clearing local data removes drafts, and local export includes them.</Text>
+    <Button className="mt-3" label="Back to Shelf" disabled={busy} onPress={() => backOrReplace(router, APP_SHELF_ROUTE)} />
+    {!admitted ? <Text accessibilityRole="alert" className="mt-3">Draft access closed. Reopen under current adult and privacy access.</Text> : <>
+      {error ? <Text accessibilityRole="alert" className="mt-3">Draft recovery unavailable or changed. Nothing was reset. Refresh before retrying; uncertain encrypted data is preserved.</Text> : null}
+      <Button className="mt-3" label="Refresh saved drafts" disabled={busy} onPress={() => void refresh()} />
+      {busy ? <Text className="mt-3">Verifying private draft storage.</Text> : null}
+      <ScrollView contentContainerClassName="pb-8">
+        {collection?.drafts.length === 0 ? <Text className="mt-3">No saved bottle drafts.</Text> : null}
+        {!error && collection?.drafts.map(row => {
+          const product = [...(shelf.data?.items ?? []), ...(shelf.data?.archive ?? [])].find(item => item.id === row.source.productId)?.product;
+          return <View key={row.id} className="mt-4 rounded-[12px] border border-hairline p-4">
+            <Text variant="body" className="font-sans-semibold">{product?.name ?? 'Bottle no longer on Shelf'}</Text>
+            <Text className="mt-2">Saved draft revision {row.revision}. Source bottle revision {row.source.revision}. Saved {row.updatedAt}.</Text>
+            <Button className="mt-3" label="Open bottle to resume draft" disabled={busy || !!selected || !product || shelf.isError || shelf.isFetching} onPress={() => {
+              if (!lease || flight.current || selectedRef.current || !visible.current) return;
+              try { assertOriginalHealthDataWriteLease(lease); } catch { return; }
+              router.push({ pathname: '/shelf/formula-history', params: { id: row.source.productId } });
+            }} />
+            <Button className="mt-2" label="Review draft discard" disabled={busy || !!selected} onPress={() => {
+              if (!lease || flight.current || selectedRef.current || !visible.current) return;
+              try { assertOriginalHealthDataWriteLease(lease); } catch { return; }
+              selectedRef.current = row; setSelected(row);
+            }} />
+            {selected === row ? <View className="mt-3">
+              <Text accessibilityRole="alert">Discard this saved transcription? Confirmed observations and other drafts stay intact.</Text>
+              <Button className="mt-3" label="Confirm saved draft discard" disabled={busy} onPress={() => void discard(row)} />
+              <Button className="mt-2" label="Keep saved draft" disabled={busy} onPress={() => {
+                if (flight.current || selectedRef.current !== row) return;
+                selectedRef.current = null; setSelected(null);
+              }} />
+            </View> : null}
+          </View>;
+        })}
+      </ScrollView>
+    </>}
+  </Screen>;
+}
