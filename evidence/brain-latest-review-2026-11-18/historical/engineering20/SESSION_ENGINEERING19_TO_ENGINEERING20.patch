+import { expect, it, vi } from 'vitest';
+import { createWebRuntimeAdmission, gateWebRuntimeStorage, PRIVATE_WEB_RUNTIME_LOCK, type RuntimeLockPort } from './webRuntimeAdmission';
+
+it('holds one exclusive origin lock for the document lifetime without steal or unmount release', async () => {
+  let held = false;
+  const request = vi.fn<RuntimeLockPort['request']>(async (_name, _options, callback) => {
+    if (held) return callback(null);
+    held = true;
+    return callback({ name: PRIVATE_WEB_RUNTIME_LOCK }).finally(() => { held = false; });
+  });
+  const first = createWebRuntimeAdmission({ request }), second = createWebRuntimeAdmission({ request });
+  const changed = vi.fn(); const unsubscribe = first.subscribe(changed);
+  first.subscribe(() => { throw new Error('Synthetic notification failure'); });
+  first.retry(); await Promise.resolve();
+  expect(first.snapshot()).toBe('admitted');
+  unsubscribe(); first.retry(); second.retry(); await Promise.resolve();
+  expect(second.snapshot()).toBe('occupied'); expect(held).toBe(true);
+  expect(request).toHaveBeenCalledTimes(2);
+  expect(request.mock.calls.every(([name, options]) => name === PRIVATE_WEB_RUNTIME_LOCK &&
+    JSON.stringify(options) === JSON.stringify({ mode: 'exclusive', ifAvailable: true }))).toBe(true);
+});
