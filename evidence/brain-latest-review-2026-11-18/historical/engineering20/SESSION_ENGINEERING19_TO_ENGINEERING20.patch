+import { AGE_POLICY_RECEIPT_KEY } from '@/features/onboarding/ageGate';
+import { classifyAgePolicyReceipt } from '@/features/onboarding/ageGateStore';
+import { hasCurrentHealthDataCollectionConsentBytes } from '@/features/onboarding/healthConsentStore';
+import { HEALTH_DATA_LIFECYCLE_KEY, parseHealthDataLifecycleRecord } from '@/features/healthConsent/lifecycleStore';
+import { assertOriginalHealthDataWriteLease, type HealthDataWriteLease } from '@/lib/consent/healthDataWriteAdmission';
+import { updatePrivateItemWithSources } from '@/lib/storage/privateKV';
+import {
+  BOTTLE_DRAFT_KEY, BOTTLE_DRAFT_AUTHORITY, BOTTLE_DRAFT_CONFLICT, BOTTLE_DRAFT_LIMIT,
+  decodeBottleDraftCollection, decodeBottleDraftFields, makeBottleDraft, bottleDraftSource,
+  type BottleDraft, type BottleDraftSource, type BottleDraftFields, type BottleDraftCollection,
+} from './bottleDraftCodec';
+
+const CONSENT_KEY = 'layerwell.healthDataCollectionConsent.v1';
+const SHELF_KEY = 'layerwell.shelf.v1';
+export const BOTTLE_DRAFT_AUTHORIZATION_KEYS = [AGE_POLICY_RECEIPT_KEY, CONSENT_KEY, HEALTH_DATA_LIFECYCLE_KEY] as const;
+
+/** These reserved authority records are authenticated before draft/Shelf reads. */
+export function bottleDraftAuthorization(lease: HealthDataWriteLease) {
+  return {
+    keys: BOTTLE_DRAFT_AUTHORIZATION_KEYS,
+    validate(values: ReadonlyMap<string, string | null>) {
+      assertOriginalHealthDataWriteLease(lease);
+      if (classifyAgePolicyReceipt(values.get(AGE_POLICY_RECEIPT_KEY) ?? null) !== 'current' ||
+          !hasCurrentHealthDataCollectionConsentBytes(values.get(CONSENT_KEY) ?? null)) throw new Error(BOTTLE_DRAFT_AUTHORITY);
+      const lifecycle = parseHealthDataLifecycleRecord(values.get(HEALTH_DATA_LIFECYCLE_KEY) ?? '');
+      if (lifecycle.ownerUserId !== lease.ownerUserId || lifecycle.processingEpoch !== lease.epoch ||
+          lifecycle.state !== 'active' || lifecycle.activationRoutePending) throw new Error(BOTTLE_DRAFT_AUTHORITY);
+    },
+  };
+}
+export function assertExactBottleDraft(raw: string | null, lease: HealthDataWriteLease, expected: BottleDraft): void {
+  const current = decodeBottleDraftCollection(raw, lease.ownerUserId, lease.epoch).drafts.find(row => row.id === expected.id);
+  if (!current || JSON.stringify(current) !== JSON.stringify(expected)) throw new Error(BOTTLE_DRAFT_CONFLICT);
+}
+
+export async function loadBottleDrafts(lease: HealthDataWriteLease): Promise<BottleDraftCollection> {
+  const assertCurrent = () => assertOriginalHealthDataWriteLease(lease);
+  assertCurrent();
+  let result: BottleDraftCollection | undefined;
+  await updatePrivateItemWithSources(BOTTLE_DRAFT_KEY, BOTTLE_DRAFT_AUTHORIZATION_KEYS, values => {
+    const raw = values.get(BOTTLE_DRAFT_KEY) ?? null;
+    result = decodeBottleDraftCollection(raw, lease.ownerUserId, lease.epoch);
+    return raw;
+  }, assertCurrent, undefined, undefined, bottleDraftAuthorization(lease));
+  assertCurrent();
+  return result!;
+}
+
+/** Explicit save only. Incomplete text remains unconfirmed and device-local. */
+export async function saveBottleDraft(lease: HealthDataWriteLease, request: Readonly<{
+  id: string;
+  expected: BottleDraft | null;
+  source: BottleDraftSource;
+  fields: BottleDraftFields;
+}>, assertCallerCurrent: () => void): Promise<BottleDraft> {
+  const assertCurrent = () => { assertOriginalHealthDataWriteLease(lease); assertCallerCurrent(); };
+  assertCurrent();
+  const source = bottleDraftSource(request.source);
+  const fields = decodeBottleDraftFields(request.fields);
+  // Copy the request before awaiting; no mutable caller alias grants authority.
+  const expected = request.expected ? JSON.stringify(request.expected) : null;
+  const id = request.id;
+  const { bottleHistorySnapshotFromBytes } = await import('./store');
+  assertCurrent();
+  let result: BottleDraft | undefined;
+  await updatePrivateItemWithSources(BOTTLE_DRAFT_KEY, [...BOTTLE_DRAFT_AUTHORIZATION_KEYS, SHELF_KEY], values => {
+    assertCurrent();
+    const raw = values.get(BOTTLE_DRAFT_KEY) ?? null;
+    const collection = decodeBottleDraftCollection(raw, lease.ownerUserId, lease.epoch);
+    const existing = collection.drafts.find(row => row.source.productId === source.productId);
+    if (collection.drafts.some(row => row.id === id && row.source.productId !== source.productId)) throw new Error(BOTTLE_DRAFT_CONFLICT);
+    if ((existing ? JSON.stringify(existing) : null) !== expected || (existing && existing.id !== id)) throw new Error(BOTTLE_DRAFT_CONFLICT);
+    const currentSource = bottleHistorySnapshotFromBytes(values.get(SHELF_KEY) ?? null, source.productId);
+    if (!currentSource || JSON.stringify(bottleDraftSource(currentSource)) !== JSON.stringify(source)) throw new Error(BOTTLE_DRAFT_CONFLICT);
+    if (existing && JSON.stringify(existing.source) === JSON.stringify(source) && JSON.stringify(existing.fields) === JSON.stringify(fields)) {
+      result = existing;
+      return raw;
+    }
+    if (!existing && collection.drafts.length >= BOTTLE_DRAFT_LIMIT) throw new Error(BOTTLE_DRAFT_CONFLICT);
+    const now = new Date().toISOString();
+    result = makeBottleDraft({ id, revision: (existing?.revision ?? 0) + 1,
+      createdAt: existing?.createdAt ?? now, updatedAt: now, source, fields });
+    const next = JSON.stringify({ ...collection, drafts: [...collection.drafts.filter(row => row.id !== id), result] });
+    decodeBottleDraftCollection(next, lease.ownerUserId, lease.epoch);
+    return next;
+  }, assertCurrent, undefined, undefined, bottleDraftAuthorization(lease));
+  assertCurrent();
+  return result!;
+}
+
+/** Exact revision retirement, including after confirmed observation readback.
+ * Missing or successor data is never treated as permission to remove it. */
+export async function discardBottleDraft(lease: HealthDataWriteLease, expected: BottleDraft, assertCallerCurrent: () => void): Promise<void> {
+  const assertCurrent = () => { assertOriginalHealthDataWriteLease(lease); assertCallerCurrent(); };
+  assertCurrent();
+  const accepted = JSON.stringify(expected);
+  const acceptedId = expected.id;
+  await updatePrivateItemWithSources(BOTTLE_DRAFT_KEY, BOTTLE_DRAFT_AUTHORIZATION_KEYS, values => {
+    assertCurrent();
+    const raw = values.get(BOTTLE_DRAFT_KEY) ?? null;
+    const collection = decodeBottleDraftCollection(raw, lease.ownerUserId, lease.epoch);
+    assertExactBottleDraft(raw, lease, JSON.parse(accepted) as BottleDraft);
+    return JSON.stringify({ ...collection, drafts: collection.drafts.filter(row => row.id !== acceptedId) });
+  }, assertCurrent, undefined, undefined, bottleDraftAuthorization(lease));
+  assertCurrent();
+}
