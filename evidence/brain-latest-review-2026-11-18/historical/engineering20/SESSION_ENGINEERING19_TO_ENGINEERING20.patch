+
+export default function BottleDraftsScreen() {
+  const health = useSyncExternalStore(subscribeActiveHealthProcessingLeaseChanges, activeHealthProcessingLeaseSnapshot, () => null);
+  return <BottleDraftsContent key={health?.generation ?? 'closed'} />;
+}
+function BottleDraftsContent() {
+  const shelf = useShelf();
+  const [lease] = useState(() => { try { return captureHealthDataWriteLease(); } catch { return null; } });
+  const [collection, setCollection] = useState<BottleDraftCollection | null>(null);
