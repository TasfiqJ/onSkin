+  const [busy, setBusy] = useState(false);
+  const flight = useRef<object | null>(null);
+  const focus = useRef(0);
+  const visible = useRef(false);
+  const refresh = useCallback(async () => {
+    if (!lease || flight.current || !visible.current) return;
+    const attempt = {}, currentFocus = focus.current;
+    flight.current = attempt; setBusy(true); setError(false);
+    setCollection(null); setSelected(null); selectedRef.current = null;
+    try {
+      assertOriginalHealthDataWriteLease(lease);
+      const result = await loadBottleDrafts(lease);
+      assertOriginalHealthDataWriteLease(lease);
+      if (visible.current && focus.current === currentFocus) setCollection(result);
+    } catch { if (visible.current && focus.current === currentFocus) setError(true); }
+    finally { if (flight.current === attempt) { flight.current = null; setBusy(false); } }
+  }, [lease]);
+  useFocusEffect(useCallback(() => {
+    visible.current = true; focus.current += 1; void refresh();
+    return () => { visible.current = false; focus.current += 1; flight.current = null;
+      selectedRef.current = null; setSelected(null); setCollection(null); };
+  }, [refresh]));
+  let admitted = false;
+  try { if (lease) { assertOriginalHealthDataWriteLease(lease); admitted = true; } } catch { /* mask retired content */ }
+  async function discard(expected: BottleDraft) {
+    if (!lease || flight.current || selectedRef.current !== expected) return;
+    const currentFocus = focus.current, attempt = {};
