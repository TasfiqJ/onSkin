new file mode 100644
index 000000000..15d03562f
--- /dev/null
+++ b/apps/mobile/src/features/today/optionalChangeDraftProof23.test.ts
@@ -0,0 +1,229 @@
+import { randomUUID } from 'node:crypto';
+import { expect, it } from 'vitest';
+import {
+  applyActualRoutine, decodeActualRoutineEnvelope, emptyActualRoutine, encodeActualRoutineEnvelope,
+} from '@/features/routine/actualRoutine';
+import { decodeCompletionLog } from './completionLogCodec';
+import {
+  hashOptionalChange41, sameOptionalChangeInput41, type OptionalChangeInput41,
+} from './optionalChange41';
+import {
+  OPTIONAL_CHANGE_DRAFT_CONFLICT, OPTIONAL_CHANGE_DRAFT_PROOF_UNVERIFIABLE,
+  decodeOptionalChangeDraftCollection, makeOptionalChangeDraft, optionalChangeDraftEventMatches,
+  reconcileOptionalChangeDraft, type OptionalChangeDraft, type OptionalChangeDraftFields,
+} from './optionalChangeDraftCodec';
+import { optionalChangeDraftSourceProofs, refreshOptionalChangeDraftProof } from './optionalChangeDraftProof';
+import {
+  appendOptionalChangeEnvelope41, decodeOptionalChangeEnvelope41, type OptionalChangeSnapshot41,
+} from './optionalChangeJournal41';
+
+// Every source below stays in memory and comes from ordinary canonical builders.
+// No storage adapter, persisted fixture injection, or authority mutation is used.
+const OWNER = 'synthetic-optional-proof-owner';
+const DAY = '2026-11-17';
+const CREATED = '2026-11-17T12:00:00.000Z';
+const REFRESHED = '2026-11-17T13:00:00.000Z';
+
+function snapshot(raw: string | null): OptionalChangeSnapshot41 {
+  const source = decodeCompletionLog(raw, OWNER);
+  return { sourceBytes: raw, sourceProof: hashOptionalChange41(raw),
+    revision: source.changes?.revision ?? 0, events: source.changes?.events ?? [] };
+}
+
+function fields(raw: string | null, patch: Partial<OptionalChangeDraftFields> = {}): OptionalChangeDraftFields {
+  const current = snapshot(raw);
+  return { eventId: randomUUID(), kind: 'note', targetEventId: null, targetContentHash: null,
+    observedOn: DAY, category: 'personal_note', text: '  Original owner-reported text\nkept exactly.  ',
+    sourceRevision: current.revision, sourceProof: current.sourceProof, attempted: false, ...patch };
+}
+
+function draft(raw: string | null, patch: Partial<OptionalChangeDraftFields> = {}, legacy = false): OptionalChangeDraft {
+  return makeOptionalChangeDraft({ id: randomUUID(), revision: 3, createdAt: CREATED, updatedAt: CREATED,
+    fields: fields(raw, patch), ...(legacy ? {} : {
+      eventPredecessorProof: optionalChangeDraftSourceProofs(raw, OWNER).eventPredecessorProof,
+    }) });
+}
+
+function actualSource(base: string | null = null): string {
+  const ledger = applyActualRoutine(emptyActualRoutine(OWNER), {
+    source: 'local', sourceHash: hashOptionalChange41('synthetic routine source'),
+    activeProductIds: ['synthetic-cleanser'], am: [{ productId: 'synthetic-cleanser', name: 'Synthetic cleanser' }], pm: [],
+  }, { id: randomUUID(), createdAt: CREATED, expectedParentHash: null });
+  return encodeActualRoutineEnvelope(base, ledger);
+}
+
+function append(raw: string | null, factualFields = fields(raw)) {
+  const actual = decodeActualRoutineEnvelope(raw, OWNER);
+  const predecessor = actual ? actual.completionBytes : raw;
+  const source = decodeCompletionLog(predecessor, OWNER);
+  const envelope = source.changes ? decodeOptionalChangeEnvelope41(JSON.parse(predecessor!), OWNER) : null;
+  const input: OptionalChangeInput41 = {
+    id: factualFields.eventId, expectedRevision: factualFields.sourceRevision,
+    expectedSourceBytes: predecessor, expectedSourceProof: hashOptionalChange41(predecessor),
+    observedOn: factualFields.observedOn, category: factualFields.category!, text: factualFields.text,
+    kind: factualFields.kind, targetEventId: factualFields.targetEventId, confirmation: true,
+  };
+  const nextInner = appendOptionalChangeEnvelope41(predecessor, envelope, input, OWNER, CREATED, DAY);
+  const next = actual ? encodeActualRoutineEnvelope(nextInner, actual.actualRoutine) : nextInner;
+  const current = snapshot(next);
+  return { raw: next, snapshot: current, input, event: current.events.at(-1)! };
+}
+
+it('uses equal outer and predecessor proofs for ordinary completion sources', () => {
+  const history = append(null);
+  for (const raw of [null, history.raw]) {
+    expect(optionalChangeDraftSourceProofs(raw, OWNER)).toEqual({
+      sourceProof: hashOptionalChange41(raw), eventPredecessorProof: hashOptionalChange41(raw),
+    });
+  }
+});
+
+it.each([false, true])('uses the exact canonical inner append proof for a v5 source with existing history=%s', existing => {
+  const base = existing ? append(null).raw : null;
+  const raw = actualSource(base), saved = draft(raw, { attempted: true });
+  const before = decodeActualRoutineEnvelope(raw, OWNER)!;
+  const proofs = optionalChangeDraftSourceProofs(raw, OWNER);
+  const committed = append(raw, saved.fields);
+
+  expect(proofs.sourceProof).toBe(hashOptionalChange41(raw));
+  expect(proofs.eventPredecessorProof).toBe(hashOptionalChange41(before.completionBytes));
+  expect(proofs.eventPredecessorProof).not.toBe(proofs.sourceProof);
+  expect(committed.input.expectedSourceProof).toBe(saved.eventPredecessorProof);
+  expect(committed.event.sourceProof).toBe(saved.eventPredecessorProof);
+  expect(sameOptionalChangeInput41(committed.event, committed.input)).toBe(true);
+  expect(optionalChangeDraftEventMatches(saved.fields, committed.event, saved.eventPredecessorProof)).toBe(true);
+  expect(optionalChangeDraftEventMatches(saved.fields, committed.event, saved.fields.sourceProof)).toBe(false);
+  expect(reconcileOptionalChangeDraft(saved, committed.snapshot)).toBe('already_recorded');
+  expect(decodeActualRoutineEnvelope(committed.raw, OWNER)!.actualRoutine).toEqual(before.actualRoutine);
+});
+
+it.each(['note', 'correction', 'retraction'] as const)('requires exact predecessor proof as well as factual equality for %s', kind => {
+  const original = kind === 'note' ? null : append(null);
+  const raw = original?.raw ?? null;
+  const saved = draft(raw, { kind, targetEventId: original?.event.id ?? null,
+    targetContentHash: original?.event.contentHash ?? null, attempted: true });
+  const committed = append(raw, saved.fields);
+  const differentProof = hashOptionalChange41('different in-memory source');
+
+  expect(optionalChangeDraftEventMatches(saved.fields, committed.event, saved.eventPredecessorProof)).toBe(true);
+  expect(optionalChangeDraftEventMatches(saved.fields, committed.event, differentProof)).toBe(false);
+  expect(sameOptionalChangeInput41(committed.event, { ...committed.input, expectedSourceProof: differentProof })).toBe(false);
+  expect(optionalChangeDraftEventMatches({ ...saved.fields, text: 'Different owner text' }, committed.event,
+    saved.eventPredecessorProof)).toBe(false);
+});
+
+it('retains legacy exact-proof retry compatibility without adding a second history event', () => {
+  const legacy = draft(null, { attempted: true }, true);
+  const committed = append(null, legacy.fields);
+  expect(optionalChangeDraftEventMatches(legacy.fields, committed.event)).toBe(true);
+  expect(reconcileOptionalChangeDraft(legacy, committed.snapshot)).toBe('already_recorded');
+  expect(refreshOptionalChangeDraftProof(legacy, committed.snapshot, OWNER, REFRESHED)).toBe(legacy);
+  expect(appendOptionalChangeEnvelope41(committed.raw,
+    decodeOptionalChangeEnvelope41(JSON.parse(committed.raw), OWNER), committed.input, OWNER, CREATED, DAY))
+    .toBe(committed.raw);
+  expect(committed.snapshot.events).toHaveLength(1);
+});
+
+it('preserves a legacy v5 attempt whose stored outer proof cannot verify the existing inner event', () => {
+  const raw = actualSource(), legacy = draft(raw, { attempted: true }, true);
+  const original = JSON.stringify(legacy), committed = append(raw, legacy.fields);
