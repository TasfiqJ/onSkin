+// Connected real Expo UI/stores/crypto. All owners, input and injected bridge
+// outcomes are synthetic local evidence; no native/recipient qualification.
+import assert from 'node:assert/strict';
+
+export async function consumerContinuity31({ b, client, tap, keyboard, text, snapshot, capture, moduleExpression, id, height }) {
+  const evaluate = expression => b.evaluate(client, expression, true);
+  const navigate = async route => {
+    await evaluate(`(()=>{${moduleExpression}mod('/node_modules/expo-router/build/exports.js').router.push(${JSON.stringify(route)});return true})()`);
+    await b.waitForPath(client, route.split('?')[0]);
+  };
+  const key = async (name, code) => {
+    await client.send('Input.dispatchKeyEvent', { type: 'keyDown', key: name, code: name, windowsVirtualKeyCode: code });
+    await client.send('Input.dispatchKeyEvent', { type: 'keyUp', key: name, code: name, windowsVirtualKeyCode: code });
+  };
+  const dialog = '[role="dialog"][aria-label="Review routine decision"]';
+  async function contained() {
+    await b.waitForCondition(client, `(()=>{const d=document.querySelector('${dialog}');return d&&d.contains(document.activeElement)})()`, 10000, 'routine decision focus');
+    assert(await evaluate(`!![...document.querySelectorAll('button,[role="button"]')].find(n=>n.textContent.trim()==='Reload actual routine and source')?.closest('[inert]')`));
+    const ax = await client.send('Accessibility.getFullAXTree');
+    assert(!ax.nodes.some(node => !node.ignored && node.name?.value === 'Reload actual routine and source'));
+    for (let i = 0; i < 7; i++) { await key('Tab', 9); assert(await evaluate(`document.querySelector('${dialog}').contains(document.activeElement)`)); }
+  }
+  async function fault(name, afterCommit) {
