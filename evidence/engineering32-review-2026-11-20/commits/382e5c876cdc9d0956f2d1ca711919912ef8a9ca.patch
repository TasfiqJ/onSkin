+import { AGE_POLICY_RECEIPT_KEY } from '@/features/onboarding/ageGate';
+import { classifyAgePolicyReceipt } from '@/features/onboarding/ageGateStore';
+import { hasCurrentHealthDataCollectionConsentBytes } from '@/features/onboarding/healthConsentStore';
+import { HEALTH_DATA_LIFECYCLE_KEY, parseHealthDataLifecycleRecord } from '@/features/healthConsent/lifecycleStore';
+import { assertOriginalHealthDataWriteLease, type HealthDataWriteLease } from '@/lib/consent/healthDataWriteAdmission';
+import { updatePrivateItemWithSources } from '@/lib/storage/privateKV';
+import { actualRoutineSnapshotFromBytes, getActualRoutineSnapshot, applyCurrentActualRoutine, clearCurrentActualRoutine, retractActualRoutineUse } from '@/features/today/completionsStore';
+import { inspectActualRoutineApply, inspectActualRoutineCorrection, type ActualRoutineLedger } from './actualRoutine';
+import { capturePlanSource44 } from './planSourceFence44';
+import { ROUTINE_DECISION_KEY, ROUTINE_DECISION_CONFLICT, ROUTINE_DECISION_LIMIT, decodeRoutineDecision, decodeRoutineDecisions,
+  makeSavedRoutineDecision, routineDecisionHash, type RoutineDecision, type SavedRoutineDecision, type RoutineDecisionCollection } from './routineDecisionRecoveryCodec';
+
+const CONSENT_KEY = 'layerwell.healthDataCollectionConsent.v1';
+const COMPLETION_KEY = 'layerwell.completions.v1';
+const AUTH_KEYS = [AGE_POLICY_RECEIPT_KEY, CONSENT_KEY, HEALTH_DATA_LIFECYCLE_KEY] as const;
+function authorization(lease: HealthDataWriteLease) {
+  return { keys: AUTH_KEYS, validate(values: ReadonlyMap<string,string|null>) {
+    assertOriginalHealthDataWriteLease(lease);
+    if (classifyAgePolicyReceipt(values.get(AGE_POLICY_RECEIPT_KEY) ?? null) !== 'current' || !hasCurrentHealthDataCollectionConsentBytes(values.get(CONSENT_KEY) ?? null)) throw Error(ROUTINE_DECISION_CONFLICT);
+    const lifecycle = parseHealthDataLifecycleRecord(values.get(HEALTH_DATA_LIFECYCLE_KEY) ?? '');
+    if (lifecycle.ownerUserId !== lease.ownerUserId || lifecycle.processingEpoch !== lease.epoch || lifecycle.state !== 'active' || lifecycle.activationRoutePending) throw Error(ROUTINE_DECISION_CONFLICT);
+  } };
+}
+function collection(values: ReadonlyMap<string,string|null>, lease: HealthDataWriteLease) {
+  const saved = decodeRoutineDecisions(values.get(ROUTINE_DECISION_KEY) ?? null, lease.ownerUserId, lease.epoch);
+  const consentHash = routineDecisionHash(values.get(CONSENT_KEY));
+  if (saved.decisions.some(row => row.consentHash !== consentHash)) throw Error(ROUTINE_DECISION_CONFLICT);
+  return saved;
+}
+function exact(saved: RoutineDecisionCollection, expected: SavedRoutineDecision) {
+  const found = saved.decisions.find(row => row.command.request.id === expected.command.request.id);
+  if (!found || routineDecisionHash(found) !== routineDecisionHash(expected)) throw Error(ROUTINE_DECISION_CONFLICT);
+  return found;
+}
+export async function loadRoutineDecisions(lease: HealthDataWriteLease): Promise<RoutineDecisionCollection> {
+  const guard = () => assertOriginalHealthDataWriteLease(lease); guard();
+  let result: RoutineDecisionCollection | undefined;
+  await updatePrivateItemWithSources(ROUTINE_DECISION_KEY, AUTH_KEYS, values => {
+    guard(); result = collection(values, lease); return values.get(ROUTINE_DECISION_KEY) ?? null;
+  }, guard, undefined, undefined, authorization(lease));
+  guard(); return result!;
+}
+export function inspectRoutineDecision(ledger: ActualRoutineLedger, command: RoutineDecision) {
+  return command.kind === 'apply' ? inspectActualRoutineApply(ledger, command.facts, command.request) : inspectActualRoutineCorrection(ledger, command);
+}
+/** Write-ahead evidence only. This function cannot dispatch the mutation and
+ * never puts a live source capability or runtime lease in persistent storage. */
+export async function prepareRoutineDecision(lease: HealthDataWriteLease, command: RoutineDecision, assertCallerCurrent: () => void): Promise<SavedRoutineDecision> {
+  const accepted = decodeRoutineDecision(command, lease.ownerUserId);
+  const guard = () => { assertOriginalHealthDataWriteLease(lease); assertCallerCurrent(); }; guard();
+  let result: SavedRoutineDecision | undefined;
+  await updatePrivateItemWithSources(ROUTINE_DECISION_KEY, [...AUTH_KEYS, COMPLETION_KEY], values => {
+    guard(); const saved = collection(values, lease);
+    const candidate = makeSavedRoutineDecision(accepted, routineDecisionHash(values.get(CONSENT_KEY)), lease.ownerUserId);
+    const existing = saved.decisions.find(row => row.command.request.id === accepted.request.id);
+    if (existing) { result = exact(saved, candidate); return values.get(ROUTINE_DECISION_KEY) ?? null; }
+    if (saved.decisions.length >= ROUTINE_DECISION_LIMIT) throw Error('ROUTINE_DECISION_CAPACITY');
+    const ledger = actualRoutineSnapshotFromBytes(values.get(COMPLETION_KEY) ?? null, lease.ownerUserId);
+    if (accepted.kind === 'retraction') {
+      const target = ledger.uses.find(row => row.id === accepted.event.id);
+      if (!target || target.kind !== 'use' || routineDecisionHash(target) !== routineDecisionHash(accepted.event) || ledger.uses.at(-1)?.contentHash !== accepted.expectedHash) throw Error(ROUTINE_DECISION_CONFLICT);
+    } else if ((ledger.versions.at(-1)?.contentHash ?? null) !== accepted.request.expectedParentHash) throw Error(ROUTINE_DECISION_CONFLICT);
+    result = candidate;
+    const next = JSON.stringify({ ...saved, decisions: [...saved.decisions, candidate] });
+    decodeRoutineDecisions(next, lease.ownerUserId, lease.epoch); return next;
+  }, guard, undefined, undefined, authorization(lease), guard);
+  guard();
+  // Verify authenticated encrypted durable readback before dispatch is possible.
+  const readback = await loadRoutineDecisions(lease); guard();
+  return exact(readback, result!);
+}
+export async function inspectSavedRoutineDecision(lease: HealthDataWriteLease, expected: SavedRoutineDecision, assertCallerCurrent: () => void) {
+  const guard = () => { assertOriginalHealthDataWriteLease(lease); assertCallerCurrent(); }; guard();
+  const saved = exact(await loadRoutineDecisions(lease), expected); guard();
+  const ledger = await getActualRoutineSnapshot(lease); guard();
+  return inspectRoutineDecision(ledger, saved.command);
