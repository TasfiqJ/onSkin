+// Real UI/encrypted stores. Faults model local bridge acknowledgement loss;
+// they never admit source/owner/consent or alter the saved command evidence.
+import assert from 'node:assert/strict';
+export async function durableRoutine32({ b, getClient, tap, keyboard, text, snapshot, capture, moduleExpression, id, height, restart }) {
+  const evaluate = expression => b.evaluate(getClient(),expression,true);
+  const mods = `${moduleExpression}const recovery=mod('/features/routine/routineDecisionRecoveryStore.ts');const lease=mod('/lib/consent/healthDataWriteAdmission.ts').captureHealthDataWriteLease();`;
+  const rows = () => evaluate(`(async()=>{${mods}return (await recovery.loadRoutineDecisions(lease)).decisions})()`);
+  const navigate = async route => { await evaluate(`(()=>{${moduleExpression}mod('/node_modules/expo-router/build/exports.js').router.push(${JSON.stringify(route)});return true})()`); await b.waitForPath(getClient(),route); };
+  const fault = async (method,afterCommit) => evaluate(`(()=>{${moduleExpression}const original=store[${JSON.stringify(method)}];store[${JSON.stringify(method)}]=async(...args)=>{store[${JSON.stringify(method)}]=original;globalThis.__original32=${JSON.stringify(method)}==='applyCurrentActualRoutine'?args[2]:${JSON.stringify(method)}==='clearCurrentActualRoutine'?args[1]:args[3];${afterCommit?'await original(...args);':''}throw Error('SYNTHETIC32_ACK_LOST')};return true})()`);
+  const openSaved = async commandId => {
+    await keyboard('Review saved routine decisions',height);
+    const saved=await rows(), index=saved.findIndex(row=>row.command.request.id===commandId); assert(index>=0);
+    await keyboard(`Review saved ${saved[index].command.kind} decision ${index+1}`,height);
+    return saved[index];
+  };
+  const inspection = async (commandId,kind) => {
+    await openSaved(commandId); const before=await snapshot();
+    const recoveryBefore=await evaluate(`localStorage.getItem('layerwell.routineDecisionRecovery.v1')`);
+    await keyboard('Inspect original routine decision',height); await text(kind);
+    assert(await evaluate(`document.querySelector('[role="dialog"][aria-label="Review original routine decision"]').contains(document.activeElement)`));
+    const after=await snapshot(); assert.equal(after.raw,before.raw); assert.equal(after.keyHash,before.keyHash);
+    assert.equal(await evaluate(`localStorage.getItem('layerwell.routineDecisionRecovery.v1')`),recoveryBefore);
+    return {before,after};
+  };
+  await navigate('/routine/records'); await text('My actual routine');
+  // Prepared but not dispatched: a browser-process restart loses every old
+  // closure/WeakMap. Explicit retry must reacquire source and keep original ID.
+  await keyboard('Review current Shelf sequence as actual routine',height); await fault('applyCurrentActualRoutine',false);
+  await keyboard('Apply reviewed actual routine',height); await text('Check saved apply outcome');
+  const original=await evaluate('globalThis.__original32'), before=await snapshot();
+  const prepared=(await rows()).find(row=>row.command.request.id===original.id); assert(prepared); assert.equal(prepared.command.request.createdAt,original.createdAt);
+  await restart(); await text('My actual routine');
+  await evaluate(`(()=>{const seen=new WeakSet();const scale=()=>{for(const n of document.querySelectorAll('div[dir="auto"]')){if(seen.has(n))continue;seen.add(n);const s=getComputedStyle(n),size=parseFloat(s.fontSize),line=parseFloat(s.lineHeight);n.style.fontSize=size*2+'px';n.style.lineHeight=(Number.isFinite(line)?line:size*1.5)*2+'px';}};scale();globalThis.__durableText32=new MutationObserver(scale);globalThis.__durableText32.observe(document.body,{childList:true,subtree:true});return true})()`);
+  assert.equal((await snapshot()).raw,before.raw);
+  await inspection(original.id,'not_found'); await capture(id+'-restart-original-not-found');
+  await keyboard('Retry this original routine decision',height); await text('recorded_current');
+  const applied=await snapshot(); assert.equal(applied.versions.length,before.versions.length+1); assert.equal(applied.versions.at(-1).id,original.id);
+  assert.equal(applied.versions.at(-1).createdAt,original.createdAt); assert.equal(applied.uses.length,before.uses.length);
+  await keyboard('Acknowledge exact saved routine outcome',height); assert(!(await rows()).some(row=>row.command.request.id===original.id));
+  // Committed clear with lost acknowledgement: restart exposes exact current
+  // outcome and read-only inspection, followed by explicit acknowledgement.
+  await keyboard('Review clearing my applied routine',height); await fault('clearCurrentActualRoutine',true);
+  await keyboard('Confirm clearing applied routine',height); await text('Check saved correction outcome');
+  const clear=await evaluate('globalThis.__original32'); await getClient().send('Page.reload'); await text('My actual routine');
+  await inspection(clear.id,'recorded_current'); await capture(id+'-clear-restart-inspection');
+  await keyboard('Acknowledge exact saved routine outcome',height);
+  await keyboard('Review current Shelf sequence as actual routine',height); await keyboard('Apply reviewed actual routine',height); await text('Actual routine applied and read back');
+  await navigate('/today'); await b.waitForCondition(getClient(),`!!document.querySelector('[role="checkbox"][aria-checked="false"]')`,30000,'new version visible use');
+  const label=await evaluate(`document.querySelector('[role="checkbox"][aria-checked="false"]').getAttribute('aria-label')`);
