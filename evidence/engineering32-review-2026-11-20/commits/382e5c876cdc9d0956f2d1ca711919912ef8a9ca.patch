+import { useFocusEffect } from 'expo-router';
+import { useCallback, useRef, useState } from 'react';
+import { Modal, ScrollView, View } from 'react-native';
+import { Button, Text } from '@/components/ui';
+import { useModalBackgroundIsolation } from '@/lib/accessibility/modalBackground';
+import { motionAwareModalAnimation, useReduceMotionPreference } from '@/lib/accessibility/useReduceMotionPreference';
+import { assertOriginalHealthDataWriteLease, type HealthDataWriteLease } from '@/lib/consent/healthDataWriteAdmission';
+import { loadRoutineDecisions, inspectSavedRoutineDecision, acknowledgeRoutineDecision, retrySavedRoutineDecision } from './routineDecisionRecoveryStore';
+import type { SavedRoutineDecision } from './routineDecisionRecoveryCodec';
+
+export function SavedRoutineDecisions({ lease, onChanged }: { lease: HealthDataWriteLease; onChanged: () => Promise<unknown> }) {
+  const [rows, setRows] = useState<readonly SavedRoutineDecision[] | null>(null);
+  const [selected, setSelected] = useState<SavedRoutineDecision | null>(null);
+  const [feedback, setFeedback] = useState<string | null>(null);
+  const [recorded, setRecorded] = useState(false);
+  const [working, setWorking] = useState(false);
+  const [dialog, setDialog] = useState<View | null>(null);
+  const reduced = useReduceMotionPreference();
+  useModalBackgroundIsolation(dialog, selected !== null);
+  const focused = useRef(false), epoch = useRef(0), flight = useRef(false);
+  const [, renderFocus] = useState(0);
+  const renderedEpoch = epoch.current;
+  const chosen = useRef<SavedRoutineDecision | null>(null);
+  useFocusEffect(useCallback(() => {
+    focused.current = true; renderFocus(++epoch.current);
+    return () => { focused.current = false; ++epoch.current; chosen.current = null; setSelected(null); setRows(null); setFeedback(null); setRecorded(false); };
+  }, []));
+  function guard(expected: number, decision?: SavedRoutineDecision) {
+    assertOriginalHealthDataWriteLease(lease);
+    if (!focused.current || epoch.current !== expected || (decision && chosen.current !== decision)) throw Error('ROUTINE_DECISION_RETIRED');
+  }
+  function currentRender() { try { guard(renderedEpoch); return true; } catch { return false; } }
+  async function load() {
+    if (flight.current || !currentRender()) return;
+    const accepted = ++epoch.current; flight.current = true; setWorking(true); setFeedback(null); setRows(null);
+    try { guard(accepted); const saved = await loadRoutineDecisions(lease); guard(accepted); setRows(saved.decisions); }
+    catch { if (focused.current && epoch.current === accepted) setFeedback('Original decision evidence is unavailable or unsupported. Nothing was reset, replayed or removed. Retry when current private access returns.'); }
+    finally { flight.current = false; if (focused.current) setWorking(false); }
+  }
+  function close(expected: SavedRoutineDecision | null) {
+    if (chosen.current !== expected || !currentRender()) return;
+    ++epoch.current; chosen.current = null; setSelected(null); setRecorded(false); setFeedback(null);
+  }
+  async function act(action: 'inspect' | 'retry' | 'acknowledge', accepted: SavedRoutineDecision) {
+    if (chosen.current !== accepted || flight.current || !currentRender()) return;
+    const serial = epoch.current, assertCurrent = () => guard(serial, accepted);
+    flight.current = true; setWorking(true); setFeedback(null);
+    try {
+      assertCurrent();
+      if (action === 'acknowledge') {
+        if (!recorded) return;
+        await acknowledgeRoutineDecision(lease, accepted, assertCurrent); assertCurrent();
+        setRows(previous => previous?.filter(row => row !== accepted) ?? null); close(accepted);
+        setFeedback('Exact saved outcome acknowledged. Only its recovery evidence was retired; routine and original use history are unchanged.');
+      } else {
+        if (action === 'retry') { await retrySavedRoutineDecision(lease, accepted, assertCurrent); assertCurrent(); await onChanged(); assertCurrent(); }
+        const outcome = await inspectSavedRoutineDecision(lease, accepted, assertCurrent); assertCurrent();
+        setRecorded(outcome.kind === 'recorded_current' || outcome.kind === 'recorded_historical');
+        setFeedback(outcome.kind === 'not_found'
+          ? 'not_found: No exact original command was found in this readable history. This does not prove an earlier operation failed. Keep this evidence and review before any retry.'
+          : outcome.kind === 'conflict' ? 'conflict: Saved history differs from the original command. It was not rewritten. Keep this evidence for inspection.'
+          : `${outcome.kind}: Exact original command found at sequence ${outcome.sequence}. Inspection changed no records or keys. Acknowledgement is a separate action.`);
+      }
+    } catch { if (focused.current && epoch.current === serial) { setRecorded(false); setFeedback('Current authority, exact source or saved evidence could not be re-established. No success is claimed. Keep the original decision for read-only inspection; a dispatched write may still have saved. No keys were recreated.'); } }
+    finally { flight.current = false; if (focused.current) setWorking(false); }
+  }
+  return <View className="gap-3">
+    <Button label="Review saved routine decisions" variant="ghost" disabled={working} onPress={() => void load()} />
+    {rows?.length === 0 ? <Text>No unresolved original routine decisions were found in the readable recovery collection. This does not establish a missing operation outcome.</Text> : null}
+    {rows?.map((saved, index) => <View key={saved.command.request.id} className="gap-2">
+      <Text>{saved.command.kind} decision {index + 1}. Original command: {saved.command.request.id}</Text>
+      <Button label={`Review saved ${saved.command.kind} decision ${index + 1}`} disabled={working} onPress={() => {
+        if (flight.current || !currentRender()) return; ++epoch.current; chosen.current = saved; setSelected(saved); setRecorded(false); setFeedback(null);
+      }} />
+    </View>)}
+    {!selected && feedback ? <Text accessibilityLiveRegion="polite">{feedback}</Text> : null}
+    <Modal visible={selected !== null} transparent animationType={motionAwareModalAnimation(reduced, 'fade')} onRequestClose={() => close(selected)}>
+      {selected ? <View ref={setDialog} className="flex-1 justify-center bg-paper px-5 py-6" role="dialog" aria-modal accessibilityViewIsModal accessibilityLabel="Review original routine decision">
+        <ScrollView keyboardShouldPersistTaps="handled" contentContainerClassName="gap-3 pb-8">
+          <Text accessibilityRole="header">Review original {selected.command.kind} decision</Text>
+          <Text>Original command: {selected.command.request.id}</Text>
+          <Text>Original time: {'createdAt' in selected.command.request ? selected.command.request.createdAt : selected.command.request.recordedAt}</Text>
+          <Text>Nothing is replayed automatically. Canceling or leaving this review does not undo a dispatched write. Applying still records no product use.</Text>
+          {selected.command.kind === 'apply' ? <>
+            <Text>Original source reference: {selected.command.facts.sourceHash}</Text>
+            {(['am','pm'] as const).map(phase => <View key={phase}><Text>{phase.toUpperCase()} reviewed sequence</Text>
+              {selected.command.kind === 'apply' && selected.command.facts[phase].map((step,index) => <Text key={step.productId}>{index + 1}. {step.name} ({step.productId})</Text>)}</View>)}
+          </> : selected.command.kind === 'retraction' ? <>
+            <Text>Original use: {selected.command.event.id}. Plan: {selected.command.event.planId}. Day: {selected.command.event.observedOn}. Step: {selected.command.event.stepKey}.</Text>
+            <Text>Original stream predecessor: {selected.command.expectedHash}</Text>
+          </> : null}
+          {'expectedParentHash' in selected.command.request ? <Text>Original predecessor: {selected.command.request.expectedParentHash ?? 'no earlier applied version'}</Text> : null}
+          <Button label="Inspect original routine decision" disabled={working} onPress={() => void act('inspect', selected)} />
+          <Button label="Retry this original routine decision" disabled={working || recorded} onPress={() => void act('retry', selected)} />
+          {recorded ? <Button label="Acknowledge exact saved routine outcome" disabled={working} onPress={() => void act('acknowledge', selected)} /> : null}
+          <Button label="Close original routine decision" variant="ghost" onPress={() => close(selected)} />
+          {feedback ? <Text accessibilityLiveRegion="polite">{feedback}</Text> : null}
+        </ScrollView>
+      </View> : null}
+    </Modal>
+  </View>;
+}
