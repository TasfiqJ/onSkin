@@ -0,0 +1,21 @@
+import { afterEach, expect, it, vi } from 'vitest';
+import { createWebRuntimeAdmission, gateWebRuntimeStorage, type RuntimeLockPort } from './webRuntimeAdmission';
+
+afterEach(() => vi.useRealTimers());
+it('waits for a closing document once, without another UI action or private access before the callback', async () => {
+  let grant: (() => void) | undefined;
+  const request = vi.fn<RuntimeLockPort['request']>(async (_name, options, callback) => {
+    if ('ifAvailable' in options) return callback(null);
+    await new Promise<void>(resolve => { grant = resolve; });
+    return callback({});
+  });
+  const admission = createWebRuntimeAdmission({ request });
+  const storage = { getItem: vi.fn(async () => 'synthetic'), setItem: vi.fn(async () => {}), removeItem: vi.fn(async () => {}) };
+  const read = gateWebRuntimeStorage(storage, admission).getItem('synthetic');
+  admission.retry(); await Promise.resolve();
+  expect(storage.getItem).not.toHaveBeenCalled();
+  expect(admission.snapshot()).toBe('checking');
+  grant?.(); await Promise.resolve(); await Promise.resolve();
+  expect(admission.snapshot()).toBe('admitted');
+  expect(await read).toBe('synthetic'); expect(request).toHaveBeenCalledOnce();
+});
