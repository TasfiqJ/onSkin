--- /dev/null
+++ b/scripts/e2e/runtime-admission-trace32.mjs
@@ -0,0 +1,24 @@
+// Content-free diagnostics only. This observer never retries or grants access.
+export async function traceRuntimeAdmission32(client, record) {
+  client.ws.addEventListener('message', event => {
+    const message = JSON.parse(event.data);
+    if (message.method !== 'Runtime.consoleAPICalled') return;
+    const value = message.params.args?.[0]?.value;
+    if (typeof value === 'string' && value.startsWith('ADMISSION32:')) record(JSON.parse(value.slice(12)));
+  });
+  await client.send('Page.addScriptToEvaluateOnNewDocument', { source: `(() => {
+    const documentId = crypto.randomUUID(); globalThis.__runtimeDocument32 = documentId; let requestId = 0;
+    const emit = (event, facts = {}) => console.info('ADMISSION32:' + JSON.stringify({documentId, event, at: performance.now(), ...facts}));
+    emit('document');
+    for (const event of ['pagehide', 'pageshow']) addEventListener(event, e => emit(event, {persisted: e.persisted}));
+    if (!navigator.locks) { emit('unsupported'); return; }
+    const original = navigator.locks.request;
+    navigator.locks.request = function(name, options, callback) {
+      if (name !== 'layerwell.private-runtime.v1') return Reflect.apply(original, this, arguments);
+      const id = ++requestId; emit('request', {id, ifAvailable: !!options.ifAvailable});
+      return Reflect.apply(original, this, [name, options, lock => {
+        emit('callback', {id, acquired: lock !== null}); return callback(lock);
+      }]).then(value => { emit('settled', {id}); return value; }, error => { emit('rejected', {id, errorName: error.name}); throw error; });
+    };
+  })()` });
+}
