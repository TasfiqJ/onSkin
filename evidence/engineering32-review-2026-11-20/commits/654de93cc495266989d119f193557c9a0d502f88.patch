+    ['--headless=new',`--remote-debugging-port=${debugPort}`,`--user-data-dir=${mkdtempSync(path.join(tmpdir(),'onskin-contention32-'))}`,'--no-first-run','--disable-background-networking','about:blank'], {stdio:'ignore',windowsHide:true});
