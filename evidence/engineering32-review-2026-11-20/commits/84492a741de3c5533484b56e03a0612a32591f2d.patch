+import original from '@react-native-async-storage/async-storage';
+import { ROUTINE_DECISION_BROWSER_DATABASE as DB, ROUTINE_DECISION_STORAGE_KEY as KEY } from './routineDecisionStorageLocations';
+
+// Only ciphertext for this new purpose uses the durable browser transaction.
+// Encryption, key custody, source fences, owner admission and erasure remain
+// privateKV's responsibility. Never put a key or plaintext in this database.
+const STORE = 'ciphertext';
+const fail = () => new Error('ROUTINE_DECISION_DURABLE_STORAGE_UNAVAILABLE');
+async function database(create: boolean): Promise<IDBDatabase | null> {
+  if (!globalThis.indexedDB?.databases) throw fail();
+  if (!create && !(await indexedDB.databases()).some(row => row.name === DB)) return null;
+  return new Promise((resolve,reject) => {
+    const open = indexedDB.open(DB,1);
+    let refused = false;
+    open.onblocked = () => { refused = true; reject(fail()); };
+    open.onerror = () => reject(fail());
+    open.onupgradeneeded = () => {
+      if (!create || refused) { open.transaction?.abort(); return; }
+      open.result.createObjectStore(STORE);
+    };
+    open.onsuccess = () => {
+      const db = open.result;
+      if (refused) { db.close(); return; }
+      if (db.objectStoreNames.length !== 1 || !db.objectStoreNames.contains(STORE)) { db.close(); reject(fail()); return; }
+      db.onversionchange = () => db.close(); resolve(db);
+    };
+  });
+}
+async function transaction(write: boolean, value?: string | null): Promise<string | null> {
+  // An older localStorage record is retained as evidence and refused, never
+  // mistaken for absence, migrated by inspection or overwritten by this store.
+  if (value !== null && await original.getItem(KEY) !== null) throw new Error('ROUTINE_DECISION_LEGACY_STORAGE_REFUSED');
+  const db = await database(write && value !== null); if (!db) return null;
+  try {
+    return await new Promise((resolve,reject) => {
+      const tx = db.transaction(STORE,write?'readwrite':'readonly',write?{durability:'strict'}:undefined);
+      if (write && tx.durability !== 'strict') { tx.abort(); reject(fail()); return; }
+      let result: string | null = null;
+      tx.onabort = () => reject(fail()); tx.onerror = () => reject(fail());
+      tx.oncomplete = () => resolve(result);
+      const store = tx.objectStore(STORE);
+      if (write) { if (value === null) store.delete(KEY); else store.put(value,KEY); }
+      else {
+        const read = store.get(KEY);
+        read.onsuccess = () => {
+          if (read.result !== undefined && typeof read.result !== 'string') { tx.abort(); return; }
+          result = read.result ?? null;
+        };
+      }
+    });
+  } finally { db.close(); }
+}
+const storage = {
+  ...original,
+  getItem: (key: string) => key === KEY ? transaction(false) : original.getItem(key),
+  setItem: async (key: string,value: string) => { if (key === KEY) await transaction(true,value); else await original.setItem(key,value); },
+  removeItem: async (key: string) => {
+    if (key !== KEY) { await original.removeItem(key); return; }
+    // Purpose/full cleanup owns both known locations, including refused legacy.
+    await transaction(true,null); await original.removeItem(key);
+  },
+  getAllKeys: async () => {
+    const keys = await original.getAllKeys();
+    // Inventory must retain this key even when its shared encryption key is
+    // lost, preventing an empty replacement history or key regeneration.
+    const db = await database(false);
+    if (!db) return keys;
+    try {
+      const exists = await new Promise<boolean>((resolve,reject) => {
+        const tx=db.transaction(STORE,'readonly'), request=tx.objectStore(STORE).count(KEY);
+        tx.oncomplete=()=>resolve(request.result>0); tx.onabort=()=>reject(fail()); tx.onerror=()=>reject(fail());
+      });
+      return exists ? [...new Set([...keys,KEY])] : keys;
+    } finally { db.close(); }
+  },
+  multiGet: async (keys: readonly string[]): Promise<[string,string|null][]> => Promise.all(keys.map(async key => [key,await storage.getItem(key)])),
+  multiRemove: async (keys: readonly string[]) => { await Promise.all(keys.map(key=>storage.removeItem(key))); },
+};
+export default storage;
