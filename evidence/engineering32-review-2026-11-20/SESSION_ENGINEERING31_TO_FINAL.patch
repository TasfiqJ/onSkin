+// Real UI/encrypted stores. Faults model local bridge acknowledgement loss;
+// they never admit source/owner/consent or alter the saved command evidence.
+import assert from 'node:assert/strict';
+export async function durableRoutine32({ b, getClient, tap, keyboard, text, snapshot, capture, moduleExpression, id, height, restart, record, sha }) {
+  const evaluate = expression => b.evaluate(getClient(),expression,true);
+  const mods = `${moduleExpression}const recovery=mod('/features/routine/routineDecisionRecoveryStore.ts');const lease=mod('/lib/consent/healthDataWriteAdmission.ts').captureHealthDataWriteLease();`;
+  const rows = () => evaluate(`(async()=>{${mods}return (await recovery.loadRoutineDecisions(lease)).decisions})()`);
+  const rawEvidence = () => evaluate(`(async()=>{${moduleExpression}return mod('/lib/storage/privateAsyncStorage.web.ts').default.getItem('layerwell.routineDecisionRecovery.v1')})()`);
+  const rawModule=`const entry=[...__r.getModules().values()].find(row=>(row.verboseName??'').replaceAll('\\\\','/').endsWith('/lib/storage/privateAsyncStorage.web.ts'));const raw=entry.publicModule.exports.default;`;
+  let sourceRestart = 0;
+  const canonicalSource = () => evaluate(`(async()=>{${rawModule}const rows=[];for(const key of ['layerwell.shelf.v1','layerwell.skinprofile.v1','layerwell.conflict.overrides','layerwell.routineOrder.v1']){const value=await raw.getItem(key);rows.push({key,present:value!==null,sha256:value===null?null:[...new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(value)))].map(x=>x.toString(16).padStart(2,'0')).join('')})}return rows})()`);
+  const restartRoutine = async () => {
+    const before=await canonicalSource(); await restart(); await text('My actual routine');
+    const after=await canonicalSource(); record(`${id}-canonical-source-restart-${++sourceRestart}-source-hashes.json`,{before,after});
+    assert.deepEqual(after,before);
+  };
