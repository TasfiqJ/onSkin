+
+afterEach(() => vi.restoreAllMocks());
+it.each(['read','erase'] as const)('keeps a failed bulk %s pending until every dispatched operation settles', async kind => {
+  let release!: () => void, settled = false, remainingFinished = false;
+  const hold = new Promise<void>(resolve => { release = resolve; });
+  const failure = new Error('synthetic storage rejection');
+  const calls: string[] = [];
+  const operation = async (key: string) => {
+    calls.push(key);
+    if (key === 'reject') throw failure;
+    await hold; remainingFinished = true;
+  };
+  vi.spyOn(storage,'getItem').mockImplementation(async key => { await operation(key); return null; });
+  vi.spyOn(storage,'removeItem').mockImplementation(operation);
+  const result = (kind === 'read' ? storage.multiGet(['reject','pending']) : storage.multiRemove(['reject','pending']))
+    .then(() => { settled = true; return null; }, error => { settled = true; return error; });
+  try {
+    await new Promise(resolve => setTimeout(resolve,0));
+    expect(calls).toEqual(['reject','pending']);
+    expect(settled).toBe(false); // An owner fence cannot retire pending I/O.
+  } finally { release(); await result; }
+  expect(remainingFinished).toBe(true);
+  expect(await result).toBe(failure);
+});
