+import original from '@react-native-async-storage/async-storage';
+import { ROUTINE_DECISION_BROWSER_DATABASE as DB, ROUTINE_DECISION_STORAGE_KEY as KEY, ROUTINE_DECISION_BROWSER_CIPHERTEXT_KEYS as ROWS } from './routineDecisionStorageLocations';
+
+// Fixed encrypted rows only. All cryptography, exact source fences, original
+// owner/consent authority and key custody remain in privateKV.
+const STORE = 'ciphertext';
+const createdDatabases = new WeakSet<IDBDatabase>();
+const fail = () => new Error('ROUTINE_DECISION_DURABLE_STORAGE_UNAVAILABLE');
+async function settled<T>(operations: Promise<T>[]): Promise<T[]> {
+  // Failure cannot release an owner/cleanup fence while sibling I/O continues.
+  const results = await Promise.allSettled(operations);
+  return results.map(result => { if (result.status === 'rejected') throw result.reason; return result.value; });
+}
+async function database(create: boolean): Promise<IDBDatabase | null> {
+  if (!globalThis.indexedDB?.databases) throw fail();
+  if (!create && !(await indexedDB.databases()).some(row => row.name === DB)) return null;
+  return new Promise((resolve,reject) => {
+    const open = indexedDB.open(DB,1); let refused = false;
+    open.onblocked = () => { refused = true; reject(fail()); };
+    open.onerror = () => reject(fail());
+    open.onupgradeneeded = () => {
+      if (!create || refused) { open.transaction?.abort(); return; }
+      open.result.createObjectStore(STORE);
+      createdDatabases.add(open.result);
+    };
+    open.onsuccess = () => {
+      const db = open.result;
+      if (refused) { db.close(); return; }
+      if (db.objectStoreNames.length !== 1 || !db.objectStoreNames.contains(STORE)) { db.close(); reject(fail()); return; }
+      db.onversionchange = () => db.close(); resolve(db);
+    };
+  });
+}
+async function transaction(key: string, write: boolean, value?: string | null): Promise<string | null> {
+  const legacy = await original.getItem(key);
+  // Earlier localStorage recovery prototypes have no durable preparation proof.
+  if (key === KEY && value !== null && legacy !== null) throw new Error('ROUTINE_DECISION_LEGACY_STORAGE_REFUSED');
+  // Explicit preparation may atomically preserve an authenticated legacy ledger
+  // predecessor with its new evidence. A read never migrates or creates a DB.
+  const legacySnapshots = write ? await Promise.all(ROWS.map(async row => [row,await original.getItem(row)] as const)) : [];
+  const db = await database(write);
+  if (!db) return key === KEY ? null : legacy;
+  try {
+    return await new Promise((resolve,reject) => {
+      const tx = db.transaction(STORE,write?'readwrite':'readonly',write?{durability:'strict'}:undefined);
+      if (write && tx.durability !== 'strict') { tx.abort(); reject(fail()); return; }
+      let result: string | null = null;
+      // A request error aborts by default. Wait for the terminal abort event,
+      // rather than retiring the caller's fence during a still-live transaction.
+      tx.onabort = () => reject(fail()); tx.oncomplete = () => resolve(result);
+      const store = tx.objectStore(STORE), inventory = store.getAllKeys();
+      inventory.onsuccess = () => {
+        if (inventory.result.some(row => typeof row !== 'string' || !ROWS.includes(row))) { tx.abort(); return; }
+        if (write) {
+          // Copy fixed legacy ciphertext byte-for-byte only when the store is
+          // first provisioned by an explicit mutation. Later absence never
+          // adopts a stale localStorage shadow after deletion or withdrawal.
+          if (createdDatabases.has(db)) for (const [row,raw] of legacySnapshots) {
+            if (row !== KEY && row !== key && raw !== null) store.put(raw,row);
+          }
+          if (value === null) store.delete(key); else store.put(value,key);
+        } else {
+          const read = store.get(key);
+          read.onsuccess = () => {
+            if (read.result !== undefined && typeof read.result !== 'string') { tx.abort(); return; }
+            // After the durable store exists, a missing primary plus retained
+            // legacy bytes is ambiguous. Never resurrect that shadow or call it
+            // an empty history. Purpose/full cleanup owns both locations.
+            if (read.result === undefined && legacy !== null) { tx.abort(); return; }
+            result = read.result ?? null;
+          };
+        }
+      };
+    });
+  } finally { db.close(); }
+}
+const storage = {
+  ...original,
+  getItem: (key: string) => ROWS.includes(key) ? transaction(key,false) : original.getItem(key),
+  setItem: async (key: string,value: string) => { if (ROWS.includes(key)) await transaction(key,true,value); else await original.setItem(key,value); },
+  removeItem: async (key: string) => {
+    if (!ROWS.includes(key)) { await original.removeItem(key); return; }
+    // A strict empty primary is established even for an old legacy-only store;
+    // legacy bytes reappearing after a crash must refuse, never fall back.
+    await transaction(key,true,null); await original.removeItem(key);
+  },
+  getAllKeys: async () => {
+    const keys = await original.getAllKeys(), db = await database(false);
+    if (!db) return keys;
+    try {
+      const retained = await new Promise<string[]>((resolve,reject) => {
+        const tx=db.transaction(STORE,'readonly'), request=tx.objectStore(STORE).getAllKeys();
+        tx.oncomplete=()=>{
+          if(request.result.some(row=>typeof row!=='string'||!ROWS.includes(row))) { reject(fail()); return; }
+          resolve(request.result as string[]);
+        };
+        tx.onabort=()=>reject(fail());
+      });
+      return [...new Set([...keys,...retained])];
+    } finally { db.close(); }
+  },
+  multiGet: async (keys: readonly string[]): Promise<[string,string|null][]> => settled(keys.map(async (key): Promise<[string,string|null]> => [key,await storage.getItem(key)])),
+  multiRemove: async (keys: readonly string[]) => { await settled(keys.map(key=>storage.removeItem(key))); },
+};
+export default storage;
