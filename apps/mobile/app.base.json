{
  "expo": {
    "name": "Layerwell",
    "slug": "layerwell",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "layerwell",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "bundleIdentifier": "com.layerwell.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "deploymentTarget": "17.0",
      "icon": "./assets/expo.icon",
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use the camera to scan product barcodes, capture ingredient labels, and take guided progress photos. Barcode frames are processed on your device; label and progress photos remain local.",
        "NSFaceIDUsageDescription": "Layerwell uses Face ID to keep your private photo timeline for your eyes only.",
        "NSSupportsLiveActivities": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["1C8F.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.layerwell.app",
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#F5F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPrivateStorageProtection",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#1C1815"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan product barcodes, capture ingredient labels, and take guided progress photos. Barcode frames are processed on your device; label and progress photos remain local.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      ["expo-secure-store", { "configureAndroidBackup": false }],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#A5694B",
          "defaultChannel": "routine"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Layerwell uses Face ID to keep your private photo timeline for your eyes only."
        }
      ],
      "expo-localization",
      [
        "expo-widgets",
        {
          "enableAndroid": false,
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "LayerwellToday",
              "displayName": "Today",
              "description": "See today’s routine progress and check off the next step.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "./plugins/withLayerwellWidgetPrivacyManifest",
      "@sentry/react-native",
      "./plugins/withReleaseTransportSecurity"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
