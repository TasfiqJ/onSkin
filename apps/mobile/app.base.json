{
  "expo": {
    "name": "OnSkin",
    "slug": "onskin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onskin",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "com.onskin.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "OnSkin uses the camera to scan product barcodes, capture ingredient labels, and take guided progress photos. Camera processing happens on your device; no faceprint is stored.",
        "NSFaceIDUsageDescription": "OnSkin uses Face ID to keep your private photo timeline for your eyes only."
      }
    },
    "android": {
      "package": "com.onskin.app",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#1C1815"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan barcodes, capture ingredient labels, and take guided progress photos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#A5694B",
          "defaultChannel": "routine"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OnSkin uses Face ID to keep your private photo timeline for your eyes only."
        }
      ],
      "expo-localization",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
