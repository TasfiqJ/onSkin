{
  "cli": {
    "version": "21.0.1",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_CAMERA_STACK": "expo-camera",
        "EXPO_PUBLIC_NATIVE_CAMERA_ENABLED": "true",
        "EXPO_PUBLIC_NATIVE_OCR_ENABLED": "false",
        "EXPO_PUBLIC_IOS_WIN_BACK_ENABLED": "false"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_CAMERA_STACK": "expo-camera",
        "EXPO_PUBLIC_NATIVE_CAMERA_ENABLED": "true",
        "EXPO_PUBLIC_NATIVE_OCR_ENABLED": "true",
        "EXPO_PUBLIC_IOS_WIN_BACK_ENABLED": "false"
      }
    },
    "production": {
      "autoIncrement": false,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_CAMERA_STACK": "expo-camera",
        "EXPO_PUBLIC_NATIVE_CAMERA_ENABLED": "true",
        "EXPO_PUBLIC_NATIVE_OCR_ENABLED": "false",
        "EXPO_PUBLIC_IOS_WIN_BACK_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
