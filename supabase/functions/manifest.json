    "order-report-poll": {
      "entrypoint": "supabase/functions/order-report-poll/index.ts",
      "deployByDefault": true,
      "verifyJwt": false,
      "access": "scheduled",
      "auth": "scheduler-secret",
      "public": false,
      "resourceLimits": {
        "timeoutSeconds": 60,
        "memoryMb": 256
      },
      "requiredEnvironment": [["SUPABASE_URL"], ["APP_ENV"]],
      "requiredSecrets": [
