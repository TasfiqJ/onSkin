{
  "schemaVersion": 1,
  "resourceLimitSemantics": "Source-controlled governance budgets. Supabase enforcement and observed usage must be verified in staging before release.",
  "functions": {
    "account-deletion": {
      "entrypoint": "supabase/functions/account-deletion/index.ts",
      "deployByDefault": true,
      "verifyJwt": false,
      "access": "mixed",
      "auth": "four-lane mixed boundary: bearer JWT for begin; bearer JWT plus service-only opaque barrier RPC for preflight; 256-bit capability for status; dedicated worker secret for scheduled work",
      "public": true,
      "resourceLimits": {
        "timeoutSeconds": 60,
        "memoryMb": 256
      },
      "requiredEnvironment": [
        ["SUPABASE_URL"],
        ["APP_ENV"],
        ["ACCOUNT_DELETION_RECEIPT_HMAC_KEY_VERSION"],
        ["REVENUECAT_PROJECT_ID"],
        ["REVENUECAT_IDENTITY_TOMBSTONE_HMAC_CURRENT_VERSION"],
        ["APPLE_SIWA_VAULT_CURRENT_VERSION"]
      ],
      "requiredSecrets": [
        ["SUPABASE_SECRET_KEYS", "SUPABASE_SECRET_KEY", "SUPABASE_SERVICE_ROLE_KEY"],
        ["ACCOUNT_DELETION_PAYLOAD_KEY_HEX"],
        ["ACCOUNT_DELETION_RECEIPT_HMAC_KEY_HEX"],
        ["ACCOUNT_DELETION_WORKER_SECRET"],
        ["REVENUECAT_V2_SECRET_API_KEY"],
        ["REVENUECAT_IDENTITY_TOMBSTONE_HMAC_KEYS"],
        ["APPLE_SIWA_VAULT_KEYS"]
      ],
      "optionalEnvironment": [
        "EXPO_PUBLIC_APP_ENV",
        "EXPO_PUBLIC_POSTHOG_KEY",
        "POSTHOG_ABSENCE_INTERVAL_SECONDS",
        "EDGE_EXTERNAL_FETCH_TIMEOUT_MS",
        "EDGE_EXTERNAL_RESPONSE_MAX_BYTES",
        "USER_EDGE_BODY_MAX_BYTES"
      ],
      "conditionalEnvironment": [
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APPLE_SIWA_CLIENT_ID"]
        },
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APP_IOS_BUNDLE_IDENTIFIER"]
        },
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APPLE_TEAM_ID"]
        },
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APPLE_SIWA_KEY_ID"]
        },
        {
          "when": "APP_ENV is staging/production or any PostHog deletion signal is configured",
          "anyOf": ["POSTHOG_API_HOST"]
        },
        {
          "when": "APP_ENV is staging/production or any PostHog deletion signal is configured",
          "anyOf": ["POSTHOG_PROJECT_ID"]
        },
        {
          "when": "APP_ENV is staging/production or any PostHog deletion signal is configured",
          "anyOf": ["POSTHOG_CAPTURE_SHUTDOWN_AT"]
        },
        {
          "when": "APP_ENV is staging/production or any PostHog deletion signal is configured",
          "anyOf": ["POSTHOG_NO_RECORDINGS_EVIDENCE"]
        },
        {
          "when": "APP_ENV is staging/production or any PostHog deletion signal is configured",
          "anyOf": ["POSTHOG_NO_RECORDINGS_VERIFIED_AT"]
        }
      ],
      "conditionalSecrets": [
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APPLE_SIWA_PRIVATE_KEY"]
        },
        {
          "when": "APP_ENV is staging/production or any PostHog deletion signal is configured",
          "anyOf": ["POSTHOG_PERSONAL_API_KEY"]
        }
      ]
    },
