{
  "schemaVersion": 1,
  "resourceLimitSemantics": "Source-controlled governance budgets. Supabase enforcement and observed usage must be verified in staging before release.",
  "functions": {
    "account-deletion": {
      "entrypoint": "supabase/functions/account-deletion/index.ts",
      "deployByDefault": true,
      "verifyJwt": true,
      "access": "authenticated",
      "auth": "supabase-user-jwt",
      "public": false,
      "resourceLimits": {
        "timeoutSeconds": 60,
        "memoryMb": 256
      },
      "requiredEnvironment": [["SUPABASE_URL"]],
      "requiredSecrets": [["SUPABASE_SECRET_KEY", "SUPABASE_SERVICE_ROLE_KEY"]],
      "optionalEnvironment": [
        "EXPO_PUBLIC_POSTHOG_KEY",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_ENVIRONMENT_ID",
        "POSTHOG_DELETION_APPROVED_ALTERNATE",
        "POSTHOG_API_HOST",
        "POSTHOG_HOST",
        "EXPO_PUBLIC_POSTHOG_HOST",
        "EDGE_EXTERNAL_FETCH_TIMEOUT_MS",
        "EDGE_EXTERNAL_RESPONSE_MAX_BYTES",
        "USER_EDGE_BODY_MAX_BYTES"
      ],
      "conditionalEnvironment": [
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": [
            "APPLE_SIWA_CLIENT_ID",
            "APPLE_SIWA_SERVICE_ID",
            "APPLE_BUNDLE_ID",
            "APP_IOS_BUNDLE_IDENTIFIER"
          ]
        },
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APPLE_TEAM_ID"]
        },
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APPLE_SIWA_KEY_ID"]
        }
      ],
      "conditionalSecrets": [
        {
          "when": "the caller has a Sign in with Apple identity",
          "anyOf": ["APPLE_SIWA_PRIVATE_KEY"]
        },
        {
          "when": "RevenueCat subscriber deletion is enabled",
          "anyOf": ["REVENUECAT_SECRET_API_KEY", "REVENUECAT_REST_API_KEY"]
        },
        {
          "when": "PostHog person deletion is enabled without an approved alternate",
          "anyOf": ["POSTHOG_PERSONAL_API_KEY"]
        }
      ]
    },
    "catalog-lookup": {
      "entrypoint": "supabase/functions/catalog-lookup/index.ts",
      "deployByDefault": true,
      "verifyJwt": true,
      "access": "authenticated",
      "auth": "supabase-user-jwt",
      "public": false,
      "resourceLimits": {
        "timeoutSeconds": 60,
        "memoryMb": 256
      },
      "requiredEnvironment": [
        ["SUPABASE_URL"],
        ["EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_ANON_KEY"]
      ],
      "requiredSecrets": [["SUPABASE_SECRET_KEY", "SUPABASE_SERVICE_ROLE_KEY"]],
      "optionalEnvironment": [
        "CATALOG_RATE_LIMIT_MAX",
        "CATALOG_RATE_LIMIT_WINDOW_SECONDS",
        "EDGE_EXTERNAL_FETCH_TIMEOUT_MS",
        "EDGE_EXTERNAL_RESPONSE_MAX_BYTES",
        "OBF_API_ENABLED",
        "USER_EDGE_BODY_MAX_BYTES"
      ],
      "conditionalEnvironment": [
        {
          "when": "OBF_API_ENABLED is true",
          "anyOf": ["OBF_USER_AGENT"]
        }
      ],
      "conditionalSecrets": []
    },
    "catalog-report": {
      "entrypoint": "supabase/functions/catalog-report/index.ts",
