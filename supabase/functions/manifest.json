        "EDGE_EXTERNAL_RESPONSE_MAX_BYTES",
        "USER_EDGE_BODY_MAX_BYTES"
      ],
      "conditionalEnvironment": [
        {
          "when": "the ShopMy order-report rail is activated",
          "anyOf": ["SHOPMY_BRAND_DOMAIN"]
        }
      ],
      "conditionalSecrets": [
        {
          "when": "the ShopMy order-report rail is activated",
