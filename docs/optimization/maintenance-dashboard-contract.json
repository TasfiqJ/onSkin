{
  "schemaVersion": 1,
  "status": "definition-only",
  "privacy": {
    "contentFree": true,
    "allowedDimensions": [
      "environment",
      "release",
      "build",
      "platform",
      "os_class",
      "device_memory_class",
      "route_enum",
      "error_enum"
    ],
    "forbiddenFields": [
      "user_id",
      "account_id",
      "email",
      "name",
      "search_text",
      "barcode",
      "product_name",
      "ingredient_text",
      "photo_uri",
      "photo_bytes",
      "routine_content",
      "health_profile",
      "access_token",
      "refresh_token",
      "receipt"
    ]
  },
  "acceptance": {
    "requiredBeforeLive": [
      "namedPrimaryOwner",
      "namedBackupOwner",
      "liveUrl",
      "refreshCadenceMinutes",
      "approvedThresholds",
      "sourceValidationEvidence",
      "ringFilter",
      "platformFilter",
      "buildFilter",
      "lastReviewedAt"
    ],
    "productionThresholdPolicy": "Thresholds must be approved before observing production results and cannot be inferred from this contract or its exercise fixture."
  },
  "dashboards": [
    {
      "id": "release_health",
      "title": "Release health",
      "status": "blocked-external",
      "ownerRole": "release-on-call",
      "liveUrl": null,
      "refreshCadenceMinutes": null,
      "sources": ["Sentry release health", "App Store Connect"],
      "filters": ["environment", "release", "build", "platform", "os_class"],
      "metrics": [
        {
          "id": "crash_free_sessions_percent",
          "unit": "percent",
          "direction": "higher-is-better",
          "productionThreshold": null
        },
        {
          "id": "fatal_crash_count",
          "unit": "count",
          "direction": "lower-is-better",
          "productionThreshold": null
        },
        {
          "id": "release_adoption_percent",
          "unit": "percent",
          "direction": "context-only",
          "productionThreshold": null
        }
      ],
      "runbookSection": "release-health"
    },
    {
      "id": "artifact_governance",
      "title": "Artifact and performance governance",
      "status": "blocked-external",
      "ownerRole": "mobile-release-engineering",
      "liveUrl": null,
      "refreshCadenceMinutes": null,
      "sources": [
        "optimization export statistics",
        "signed artifact inspection",
        "device evidence packets"
      ],
      "filters": ["release", "build", "platform"],
      "metrics": [
        {
          "id": "bundle_regression_bytes",
