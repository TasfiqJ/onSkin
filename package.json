{
  "name": "onskin",
  "version": "0.1.0",
  "private": true,
  "description": "OnSkin — cross-platform skincare routine app (Expo + Supabase)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "2.9.18",
    "typescript": "~6.0.3"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20"
  }
}
