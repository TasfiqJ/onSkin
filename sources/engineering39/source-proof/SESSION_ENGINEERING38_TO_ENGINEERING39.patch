index 0000000000000000000000000000000000000000..bfc8ec8fd5fe60b5300c0090b4e75c9b39353f3e
--- /dev/null
+++ b/scripts/e2e/owner-custody-sqlite-worker.mjs
@@ -0,0 +1,142 @@
+import assert from 'node:assert/strict';
+import { existsSync } from 'node:fs';
+import { registerHooks } from 'node:module';
+import { extname } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+
+// IPC-only synthetic worker. No app, service endpoint or real grants use this driver.
+assert.equal(typeof process.send, 'function');
+const sourceRoot = new URL('../../apps/professional-web/src/', import.meta.url);
+registerHooks({
+  resolve(specifier, context, next) {
+    if (context.parentURL?.startsWith(sourceRoot.href) && specifier.startsWith('./') && !extname(specifier)) {
+      return next(`${specifier}.ts`, context);
+    }
+    return next(specifier, context);
+  },
+});
+
+const { EncryptedCustody } = await import(new URL('encryptedCustody.ts', sourceRoot));
+const { OwnerRoutineCustody } = await import(new URL('ownerRoutineCustody.ts', sourceRoot));
+const { ProfessionalAccessError } = await import(new URL('authority.ts', sourceRoot));
+const [path, input] = process.argv.slice(2);
+const command = JSON.parse(input);
+const scope = { ownerId: 'synthetic-restart-owner', healthEpoch: command.healthEpoch ?? 1 };
+const keyId = 'synthetic-sqlite-key-v1';
+const key = await crypto.subtle.importKey('raw', new Uint8Array(32).fill(39), 'AES-GCM', false, ['encrypt', 'decrypt']);
+const db = new DatabaseSync(path);
+db.exec('PRAGMA busy_timeout=10000; PRAGMA journal_mode=DELETE; PRAGMA synchronous=FULL;');
+db.exec('CREATE TABLE IF NOT EXISTS custody (key TEXT PRIMARY KEY, ciphertext TEXT NOT NULL) STRICT');
+const query = db.prepare('SELECT ciphertext FROM custody WHERE key = ?');
+const insert = db.prepare('INSERT INTO custody (key, ciphertext) VALUES (?, ?)');
+const update = db.prepare('UPDATE custody SET ciphertext = ? WHERE key = ? AND ciphertext = ?');
+const remove = db.prepare('DELETE FROM custody WHERE key = ? AND ciphertext = ?');
+const checkpointPath = command.checkpointPath;
+const checkpointDb = checkpointPath && checkpointPath !== path && existsSync(checkpointPath) ? new DatabaseSync(checkpointPath) : null;
+checkpointDb?.exec('PRAGMA busy_timeout=10000; PRAGMA synchronous=FULL;');
+let prepared = null;
+const checkpointChanged = () => { throw new ProfessionalAccessError('changed'); };
+
+// The independent test store keeps a prepared successor across an unknown
+// commit. Only the actual, authenticated successor can confirm it. Seeing the
+// old head is ambiguous, so the fixture refuses instead of adopting it.
+function confirmCheckpoint(observed) {
+  const row = checkpointDb.prepare('SELECT current, pending FROM checkpoint WHERE owner = ?').get(scope.ownerId);
+  if (!row) return checkpointChanged();
+  if (row.pending === null) {
+    if (row.current !== observed) return checkpointChanged();
+    return;
+  }
+  if (observed !== row.pending || checkpointDb.prepare('UPDATE checkpoint SET current = pending, pending = NULL WHERE owner = ? AND current IS ? AND pending = ?')
+    .run(scope.ownerId, row.current, observed).changes !== 1) return checkpointChanged();
+}
+
+async function pauseAt(phase) {
+  if (command.killAt !== phase) return;
+  // Mark the transaction boundary before parking until the parent kills this process.
+  process.once('disconnect', () => process.exit(2));
+  process.send({ phase, pid: process.pid });
+  await new Promise(() => {});
+}
+
+const driver = {
+  async transaction(work) {
+    db.exec('BEGIN IMMEDIATE');
+    let committed = false;
+    try {
+      const checks = [];
+      const result = await work({
+        now: () => 1_800_000_000_000,
+        read: async record => query.get(record)?.ciphertext ?? null,
+        compareAndSet: async (record, expected, ciphertext) => {
+          const result = expected === null ? insert.run(record, ciphertext) : update.run(ciphertext, record, expected);
+          assert.equal(result.changes, 1, 'exact ciphertext set');
+        },
+        compareAndDelete: async (record, expected) => {
+          assert.equal(remove.run(record, expected).changes, 1, 'exact ciphertext deletion');
+        },
+        beforeCommit: check => checks.push(check),
+      });
+      for (const check of checks) await check();
+      await pauseAt('before-commit');
+      db.exec('COMMIT');
+      committed = true;
+      await pauseAt('after-commit');
+      if (prepared !== null) confirmCheckpoint(prepared);
+      return result;
+    } finally {
+      if (!committed && db.isTransaction) db.exec('ROLLBACK');
+    }
+  },
+};
+
+const custody = new EncryptedCustody(driver, {
+  current: async () => ({ id: keyId, key }),
+  retained: async (_record, id) => {
+    assert.equal(id, keyId);
+    return key;
+  },
+});
+let approvals = 0;
+const history = new OwnerRoutineCustody(custody, async (_tx, access) => {
+  assert.deepEqual(access.scope, scope);
+  approvals++;
+  if (command.refuse === access.action || (command.retireBeforeCommit && approvals > 1)) throw new ProfessionalAccessError('grant');
+}, checkpointPath ? async (_tx, _scope, observed) => {
+  if (!checkpointDb) throw new ProfessionalAccessError('unavailable');
+  confirmCheckpoint(observed);
+} : command.checkpoint === undefined ? undefined : async (_tx, _scope, observed) => {
+  if (command.checkpoint !== observed) return checkpointChanged();
+}, checkpointDb ? async (_scope, { previous, next }) => {
+  if (checkpointDb.prepare('UPDATE checkpoint SET pending = ? WHERE owner = ? AND current IS ? AND pending IS NULL')
+    .run(next, scope.ownerId, previous).changes !== 1) return checkpointChanged();
+  prepared = next;
+} : undefined);
+
+async function run() {
+  switch (command.action) {
+    case 'open': return history.open(scope);
+    case 'append': return history.append(scope, command.original);
+    case 'inspect': return history.inspect(scope, command.id, command.originalHash);
+    case 'tombstone': return history.tombstone(scope);
+    case 'restore': return history.restore(scope, command.original, command.receipt);
+    case 'erase': return history.eraseTombstoned(scope, command.revision, command.limit);
+    case 'recheck': return history.recheckTombstonedErasure(scope, command.pass, command.revision, command.limit);
+    case 'checkpoint': return custody.transaction(tx => OwnerRoutineCustody.checkpoint(tx, scope));
+    default: throw new Error('Unknown synthetic command');
+  }
+}
+
+let response;
+try {
+  response = { ok: true, result: await run() ?? null };
+} catch (error) {
+  response = { ok: false, error: error.message };
+} finally {
+  db.close();
+  checkpointDb?.close();
+}
+process.send(response, error => {
+  if (error) process.exitCode = 1;
+  process.disconnect();
+});
