+  const step = routine?.[phase].find(candidate => `${phase.toUpperCase()}:${candidate.productId}` === event.stepKey);
+  if (!routine || routine.sourceHash !== event.planHash || !step) return changed();
+  if (isRetraction) {
+    await acknowledgedCommand(archive.saved, original, target);
+    const saved = archive.saved as { command: unknown };
+    const command = record(saved.command, 'event,expectedHash,kind,request');
+    const request = record(command.request, 'id,recordedAt');
+    const prior = typeof event.targetId === 'string' ? originals.get(event.targetId) : undefined;
+    if (command.kind !== 'retraction' || request.id !== event.id || request.recordedAt !== event.recordedAt ||
+        command.expectedHash !== event.previousHash || !prior || !positive(prior.sequence) || prior.sequence >= event.sequence ||
+        canonical(command.event) !== canonical(prior) || prior.planId !== event.planId || prior.planHash !== event.planHash ||
+        prior.observedOn !== event.observedOn || prior.stepKey !== event.stepKey) return changed();
+  } else if (event.targetId !== null || contentHash !== original.sourceHash) return changed();
+
+  const use = await projection({ field: 'use_events', id: event.id, sourceHash: contentHash, recordedAt: event.recordedAt,
+    observedOn: event.observedOn, productId: step.productId, name: step.name, phase, routineVersion: routine.sequence,
+    kind: event.kind, targetId: event.targetId }) as Use;
+  let formula: PrevisitRecord | null = null;
+  if (fields.includes('formulas') && schema === 2 && target.formulaAtUse !== null) {
+    const evidence = record(target.formulaAtUse, 'formula,ownedVersionHash,ownedVersionId');
+    const raw = record(evidence.formula, 'actor,basis,contentHash,id,labelStatus,labelText,market,observedOn,ownedUnitId,ownerUserId,previousFormulaVersionId,recordedAt,schemaVersion,sourceRights,variant');
+    const { id, contentHash: formulaHash, ...observation } = raw;
+    if (!digest(evidence.ownedVersionHash) || evidence.ownedVersionId !== `owned38:${evidence.ownedVersionHash}` ||
+        observation.schemaVersion !== 1 || observation.actor !== 'owner' || observation.sourceRights !== 'owner_private_observation' ||
+        observation.ownerUserId !== grant.ownerId || observation.ownedUnitId !== step.productId ||
+        observation.basis !== (observation.labelStatus === 'unknown' ? 'unavailable' : 'label_in_hand') ||
+        await recordHash(observation) !== formulaHash || id !== `formula38:${formulaHash}`) return changed();
+    const { labelStatus, labelText, market, variant, observedOn, recordedAt } = observation;
+    formula = await projection({ field: 'formulas', id: event.id, sourceHash: formulaHash, recordedAt,
+      productId: step.productId, name: step.name, labelStatus, labelText, market, variant, observedOn, atUse: true });
+  }
+  return { use, formula, sequence: event.sequence };
+}
+
+/** SERVER ONLY. The receipts come from the current grant's trusted, explicit
+ * selection resolved in this transaction. A receipt proves archive membership,
+ * not permission to select another field, practice, owner or retired epoch. */
+export async function readOwnerRoutinePrevisit(tx: EncryptedTransaction, grant: Grant,
+  requested: readonly PrevisitRecordField[], selection: readonly OwnerRoutinePrevisitReceipt[]): Promise<PrevisitRecordSource> {
+  grant = structuredClone(grant);
+  const fields = [...requested];
+  const proofs = structuredClone(selection);
+  if (!validGrant(grant) || grant.status !== 'active' || grant.expiresAt <= tx.now() ||
+    !grant.purposes.includes('pre_visit') || fields.some(field => !grant.fields.includes(field))) throw new ProfessionalAccessError('grant');
+  if (!fields.length || new Set(fields).size !== fields.length || fields.some(field => !PREVISIT_RECORD_FIELDS.includes(field)) ||
+      !Array.isArray(proofs) || proofs.length > 100) return changed();
+  const scope = { ownerId: grant.ownerId, healthEpoch: grant.healthEpoch };
+  const routines = new Map<string, Routine>();
+  const uses: { original: OriginalRoutineRecord; archive: Record<string, unknown> }[] = [];
+  const originals = new Map<string, Record<string, unknown>>();
+  const seen = new Set<string>();
+  for (const proof of proofs) {
+    const { id, receiptHash } = record(proof, 'id,receiptHash');
+    if (!uuid(id) || !digest(receiptHash) || seen.has(id)) return changed();
+    seen.add(id);
+    const entry = await OwnerRoutineCustody.readCommitted(tx, scope, id, receiptHash);
+    if (!entry || entry.original.kind === 'routine_version') return changed();
+    const { original } = entry;
+    const archive = payload(original, grant);
+    const kind = (archive.saved as { command?: { kind?: unknown } } | null)?.command?.kind;
+    if (kind === 'apply' || kind === 'clear') {
+      routines.set(id, await projectRoutine(original, grant, archive));
+    } else {
+      if ((!fields.includes('use_events') && !fields.includes('formulas')) || (original.kind !== 'use_event' && kind !== 'retraction')) return changed();
+      if (original.kind === 'use_event') originals.set(id, archive.target as Record<string, unknown>);
+      uses.push({ original, archive });
+    }
+  }
+  if (new Set(Array.from(routines.values(), row => row.sequence)).size !== routines.size) return changed();
+  const projected = [];
+  for (const { original, archive } of uses) projected.push(await projectUse(original, grant, archive, routines, originals, fields));
+  if (new Set(projected.map(row => row.sequence)).size !== projected.length) return changed();
+  projected.sort((a, b) => a.sequence - b.sequence);
+  const records: PrevisitRecord[] = fields.includes('actual_routine') ? [...routines.values()] : [];
+  for (const { use, formula } of projected) {
+    if (fields.includes('use_events')) records.push(use);
+    if (formula) records.push(formula);
+  }
+  const body = { ownerId: grant.ownerId, workspaceId: grant.workspaceId, grantId: grant.id, grantVersion: grant.version,
+    grantEpoch: grant.epoch, healthEpoch: grant.healthEpoch, fields, records };
+  return { ...body, contentHash: await recordHash(body) };
+}
