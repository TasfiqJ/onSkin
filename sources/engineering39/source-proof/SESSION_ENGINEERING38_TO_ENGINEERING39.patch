+++ b/scripts/e2e/owner-custody-sqlite.test.mjs
@@ -0,0 +1,209 @@
+import assert from 'node:assert/strict';
+import { fork } from 'node:child_process';
+import { mkdtempSync, rmSync, rmdirSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import test from 'node:test';
+
+const worker = new URL('./owner-custody-sqlite-worker.mjs', import.meta.url);
+const namespace = 'owner-routine-record:v1:synthetic-restart-owner';
+const original = {
+  id: 'synthetic-original-a', kind: 'resolved_command', sourceHash: 'a'.repeat(64),
+  previousReceipt: null, bytes: '{"command":"synthetic immutable input after restart","outcome":"resolved"}',
+};
+
+function start(database, command) {
+  return new Promise((resolve, reject) => {
+    const child = fork(worker, [database, JSON.stringify(command)], {
+      execArgv: ['--experimental-transform-types', '--disable-warning=ExperimentalWarning'], windowsHide: true,
+    });
+    const messages = [];
+    const deadline = setTimeout(() => {
+      child.kill('SIGKILL');
+      reject(new Error(`Fixture command timed out: ${command.action}`));
+    }, 15000);
+    child.on('message', message => {
+      messages.push(message);
+      if (command.killAt && message.phase === command.killAt && message.pid === child.pid) child.kill('SIGKILL');
+    });
+    child.once('error', error => { clearTimeout(deadline); reject(error); });
+    child.once('exit', (code, signal) => {
+      clearTimeout(deadline);
+      try {
+        assert.equal(messages.length, 1);
+        if (command.killAt) {
+          assert.equal(signal, 'SIGKILL');
+          assert.deepEqual(messages[0], { phase: command.killAt, pid: child.pid });
+        } else {
+          assert.equal(code, 0);
+          assert.equal(signal, null);
+          assert.equal(typeof messages[0].ok, 'boolean');
+        }
+        resolve(messages[0]);
+      } catch (error) { reject(error); }
+    });
+  });
+}
+
+function fixture(t, witness = false) {
+  const folder = mkdtempSync(join(tmpdir(), 'onskin-custody-'));
+  const database = join(folder, 'synthetic.sqlite');
+  const checkpointPath = join(folder, 'synthetic-checkpoint.sqlite');
+  if (witness) {
+    const db = new DatabaseSync(checkpointPath);
+    try {
+      db.exec('PRAGMA synchronous=FULL; CREATE TABLE checkpoint (owner TEXT PRIMARY KEY, current TEXT, pending TEXT) STRICT');
+      db.prepare('INSERT INTO checkpoint (owner, current, pending) VALUES (?, NULL, NULL)').run('synthetic-restart-owner');
+    } finally { db.close(); }
+  }
+  t.after(() => {
+    for (const file of [database, checkpointPath]) {
+      for (const suffix of ['', '-journal', '-shm', '-wal']) rmSync(file + suffix, { force: true });
+    }
+    rmdirSync(folder);
+  });
+  return {
+    run: command => start(database, witness ? { checkpointPath, ...command } : command),
+    read() {
+      const db = new DatabaseSync(database, { readOnly: true });
+      try { return db.prepare('SELECT key, ciphertext FROM custody ORDER BY key').all(); }
+      finally { db.close(); }
+    },
+    reinsert(record) {
+      const db = new DatabaseSync(database);
+      try { db.prepare('INSERT INTO custody (key, ciphertext) VALUES (?, ?)').run(record.key, record.ciphertext); }
+      finally { db.close(); }
+    },
+    restoreFixtureSnapshot(rows) {
+      const db = new DatabaseSync(database);
+      try {
+        db.exec('BEGIN IMMEDIATE; DELETE FROM custody');
+        const insert = db.prepare('INSERT INTO custody (key, ciphertext) VALUES (?, ?)');
+        for (const row of rows) insert.run(row.key, row.ciphertext);
+        db.exec('COMMIT');
+      } finally { db.close(); }
+    },
+    witnessState() {
+      const db = new DatabaseSync(checkpointPath, { readOnly: true });
+      try { return { ...db.prepare('SELECT current, pending FROM checkpoint').get() }; }
+      finally { db.close(); }
+    },
+  };
+}
+
+const good = async (run, command) => {
+  const reply = await run(command);
+  assert.equal(reply.ok, true, reply.error);
+  return reply.result;
+};
+
+const refused = async (run, command, code) => assert.deepEqual(await run(command), { ok: false, error: `PROFESSIONAL_ACCESS_${code}` });
+
+test('process death before commit rolls back; after commit recovers the exact encrypted original', async t => {
+  const { run, read } = fixture(t);
+  await good(run, { action: 'open' });
+  const before = read();
+  await run({ action: 'append', original, killAt: 'before-commit' });
+  assert.deepEqual(read(), before);
+  await run({ action: 'append', original, killAt: 'after-commit' });
+  const committed = read();
+  assert.notDeepEqual(committed, before);
+  assert.match(committed.find(row => row.key.endsWith(original.id)).ciphertext, /"keyId":"synthetic-sqlite-key-v1"/);
+  assert.ok(!JSON.stringify(committed).includes('synthetic immutable input'));
+
+  const receipt = await good(run, { action: 'append', original });
+  assert.equal(receipt.sequence, 1);
+  assert.deepEqual(await good(run, { action: 'inspect', id: original.id, originalHash: receipt.originalHash }), { original, receipt });
+  assert.deepEqual(read(), committed);
+  await refused(run, { action: 'append', original: { ...original, bytes: 'different immutable input' } }, 'CHANGED');
+  const rivals = await Promise.all(['b', 'c'].map(id => run({ action: 'append', original: {
+    ...original, id, previousReceipt: receipt.hash,
+  } })));
+  assert.equal(rivals.filter(result => result.ok && result.result.sequence === 2).length, 1);
+  assert.deepEqual(rivals.filter(result => !result.ok), [{ ok: false, error: 'PROFESSIONAL_ACCESS_CHANGED' }]);
+});
+
+test('tombstone survives restart; authentic reappeared bytes require an exact, retryable erasure pass', async t => {
+  const { run, read, reinsert } = fixture(t);
+  await good(run, { action: 'open' });
+  const receipt = await good(run, { action: 'append', original });
+  const record = read().find(row => row.key === `${namespace}:1:${original.id}`);
+  await run({ action: 'tombstone', killAt: 'after-commit' });
+  await refused(run, { action: 'restore', original, receipt }, 'CHANGED');
+  await good(run, { action: 'open', healthEpoch: 2 });
+  const erase = { action: 'erase', revision: 0, limit: 1 };
+  const completed = await good(run, erase);
+  assert.equal(completed.complete, true);
+  reinsert(record);
+  const beforeRecheck = read();
+  const checkpoint = await good(run, { action: 'checkpoint' });
+  const recheck = { action: 'recheck', pass: 1, revision: 0, limit: 1, checkpoint };
+  await refused(run, { ...recheck, refuse: 'recheck_erasure' }, 'GRANT');
+  await refused(run, { ...recheck, checkpoint: 'b'.repeat(64) }, 'CHANGED');
+  await run({ ...recheck, killAt: 'before-commit' });
+  assert.deepEqual(read(), beforeRecheck);
+  await run({ ...recheck, killAt: 'after-commit' });
+  assert.ok(!read().some(row => row.key === record.key));
+  const result = await good(run, recheck);
+  assert.deepEqual(result, { pass: 1, progress: completed });
+  assert.deepEqual(await good(run, erase), completed);
+  await refused(run, { ...recheck, limit: 2 }, 'CHANGED');
+  await refused(run, { ...recheck, pass: 3 }, 'CHANGED');
+  await refused(run, { action: 'restore', original, receipt }, 'CHANGED');
+
+  reinsert(record);
+  const ciphertextReturned = read();
+  assert.deepEqual(await good(run, recheck), result);
+  assert.deepEqual(read(), ciphertextReturned);
+  assert.equal((await good(run, { ...recheck, pass: 2 })).progress.removed, 1);
+  assert.ok(!read().some(row => row.key === record.key));
+});
+
+test('independent checkpoint confirms a committed successor after restart and rejects older authentic custody', async t => {
+  const { run, read, restoreFixtureSnapshot, witnessState } = fixture(t, true);
+  await good(run, { action: 'open' });
+  const before = read();
+  const oldHead = await good(run, { action: 'checkpoint' });
+  assert.deepEqual(witnessState(), { current: oldHead, pending: null });
+  await refused(run, { action: 'append', original, retireBeforeCommit: true }, 'GRANT');
+  assert.deepEqual(read(), before);
+  assert.deepEqual(witnessState(), { current: oldHead, pending: null });
+
+  await run({ action: 'append', original, killAt: 'after-commit' });
+  const committed = read();
+  const nextHead = await good(run, { action: 'checkpoint' });
+  assert.notEqual(nextHead, oldHead);
+  assert.deepEqual(witnessState(), { current: oldHead, pending: nextHead });
+  const receipt = await good(run, { action: 'append', original });
+  assert.equal(receipt.sequence, 1);
+  assert.deepEqual(witnessState(), { current: nextHead, pending: null });
+  assert.deepEqual(read(), committed);
+
+  restoreFixtureSnapshot(before);
+  await refused(run, { action: 'append', original }, 'CHANGED');
+  assert.deepEqual(read(), before);
+  assert.deepEqual(witnessState(), { current: nextHead, pending: null });
+  restoreFixtureSnapshot(committed);
+  await good(run, { action: 'tombstone' });
+  restoreFixtureSnapshot(committed);
+  await refused(run, { action: 'inspect', id: original.id, originalHash: receipt.originalHash }, 'CHANGED');
+  assert.deepEqual(read(), committed);
+});
+
+test('an interrupted prepared successor with the old custody head remains unavailable to ordinary retry', async t => {
+  const { run, read, witnessState } = fixture(t, true);
+  await good(run, { action: 'open' });
+  const before = read();
+  const oldHead = await good(run, { action: 'checkpoint' });
+  await run({ action: 'append', original, killAt: 'before-commit' });
+  assert.deepEqual(read(), before);
+  const prepared = witnessState();
+  assert.equal(prepared.current, oldHead);
+  assert.match(prepared.pending, /^[a-f0-9]{64}$/u);
+  assert.notEqual(prepared.pending, oldHead);
+  await refused(run, { action: 'append', original }, 'CHANGED');
+  await refused(run, { action: 'open' }, 'CHANGED');
+  assert.deepEqual(read(), before);
+  assert.deepEqual(witnessState(), prepared);
+});
